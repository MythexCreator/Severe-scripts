        Make("Square",{Visible=true,Filled=true,Color=C.Acc,Size=Vector2.new(sw,2),Position=Vector2.new(sx,sy),ZIndex=132})

        -- Avatar circle
        local ax = sx+sw/2
        local ay = sy+45
        Make("Circle",{Visible=true,Filled=true,Color=C.Acc,Radius=26,Position=Vector2.new(ax,ay),ZIndex=132,NumSides=30})
        Make("Circle",{Visible=true,Filled=false,Color=C.Wht,Radius=27,Position=Vector2.new(ax,ay),ZIndex=133,NumSides=30,Thickness=2})
        Make("Text",{Visible=true,Text=plr.DisplayName:sub(1,1):upper(),Size=24,Color=C.Wht,Position=Vector2.new(ax,ay-13),Center=true,ZIndex=133,Outline=true})

        -- Info
        Make("Text",{Visible=true,Text=plr.DisplayName,Size=14,Color=C.Wht,Position=Vector2.new(ax,sy+78),Center=true,ZIndex=132,Outline=true})
        Make("Text",{Visible=true,Text="@"..plr.Name,Size=11,Color=C.Dim,Position=Vector2.new(ax,sy+94),Center=true,ZIndex=132,Outline=true})
        Make("Text",{Visible=true,Text="ID: "..tostring(plr.UserId),Size=10,Color=C.Dim,Position=Vector2.new(ax,sy+108),Center=true,ZIndex=132,Outline=true})
        Make("Square",{Visible=true,Filled=true,Color=C.Brd,Size=Vector2.new(sw-20,1),Position=Vector2.new(sx+10,sy+122),ZIndex=132})

        -- Action buttons
        R.ProfileBtns = {}
        local isSpectating = SelectedPlayer and workspace.CurrentCamera.CameraSubject ~= GetHum()
        local actions = {
            {Name=isSpectating and "Unspectate" or "Spectate", Key="spectate"},
            {Name="Goto",      Key="goto"},
            {Name="Bring",     Key="bring"},
            {Name="Fling",     Key="fling"},
            {Name="Kill",      Key="kill"},
            {Name="Loop Kill", Key="loopkill"},
            {Name="Copy Name", Key="copyname"},
        }
        for i,action in actions do
            local by = sy+128+(i-1)*22
            local col = (action.Key=="fling" or action.Key=="kill" or action.Key=="loopkill") and C.Red or
                        (action.Key=="spectate" and isSpectating and C.TabOn or C.Btn)
            Make("Square",{Visible=true,Filled=true,Color=col,Size=Vector2.new(sw-16,20),Position=Vector2.new(sx+8,by),ZIndex=132,Rounding=4})
            Make("Text",{Visible=true,Text=action.Name,Size=12,Color=C.Wht,Position=Vector2.new(sx+sw/2,by+3),Center=true,ZIndex=133,Outline=true})
            R.ProfileBtns[i] = {P=Vector2.new(sx+8,by), S=Vector2.new(sw-16,20), Key=action.Key}
