        Make("Square",{Visible=true,Filled=true,Color=C.Acc,Size=Vector2.new(sw,2),Position=Vector2.new(sx,sy),ZIndex=132})
        Make("Text",{Visible=true,Text=ShowSideMenu:upper(),Size=13,Color=C.Acc,Position=Vector2.new(sx+12,sy+8),ZIndex=132,Outline=true})
