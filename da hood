                    R.IR[item.Key] = {P=Vector2.new(cX,sY), S=Vector2.new(cW,22), I=item}

                elseif item.Type=="Slider" then
                    Make("Text",{Visible=true,Text=item.Name..": "..tostring(SlVals[item.Key]),Size=11,Color=C.Txt,Position=Vector2.new(cX+5,sY+1),ZIndex=107,Outline=true})
