local function DoLogic()
    local char = GetChar()
    local hum = GetHum()
    local rp = GetRP()
    local keys = GetKeys()

    -- Speed
    if hum and FrameN % 10 == 0 then
        if TogStates.speed_on then
            local val = SlVals.speed_val
            if memory.readf32(hum,OFF.WS) ~= val then
                memory.writef32(hum,OFF.WS,val)
                memory.writef32(hum,OFF.WC,val)
            end
        end
    end

    -- Jump Power
    if hum and FrameN % 10 == 0 then
        if TogStates.jump_on then
            local val = SlVals.jump_val
            if memory.readf32(hum,OFF.JP) ~= val then memory.writef32(hum,OFF.JP,val) end
        end
    end

    -- No Jump Cooldown
    if hum and TogStates.no_jump_cd and FrameN % 3 == 0 then
        memory.writef32(hum, OFF.JP, TogStates.jump_on and SlVals.jump_val or 50)
    end

    -- Infinite Jump
    if rp and TogStates.inf_jump then
        local space = HasKey(keys,"Space")
        if space and not WasSpaceDown and rp.Velocity.Y ~= 0 then
            rp.Velocity = Vector3.new(rp.Velocity.X, 50, rp.Velocity.Z)
        end
        WasSpaceDown = space
    end

    -- Anti Void
    if rp and TogStates.anti_void then
        if math.abs(rp.Velocity.Y) < 1.5 then LastStablePos = rp.CFrame end
        if rp.Position.Y < -40 and LastStablePos then
            rp.CFrame = LastStablePos
            rp.Velocity = Vector3.new(0,0,0)
        end
    end

    -- Anti Stomp
    if char and TogStates.anti_stomp and FrameN % 3 == 0 then
        local be = char:FindFirstChild("BodyEffects")
        if be then
            for _,v in be:GetChildren() do
                if v:IsA("BoolValue") and v.Value == true then
                    local n = v.Name:lower()
                    if n:find("ko") or n:find("knock") or n:find("down") or n:find("ragdoll") then
                        ForceReset()
                        break
                    end
                end
            end
        end
    end

    -- Noclip
    if char and TogStates.noclip then
        for _,v in char:GetDescendants() do
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
        end
    end

    -- Anti Slow
    if hum and TogStates.anti_slow and not TogStates.speed_on and FrameN % 10 == 0 then
        local ws = memory.readf32(hum, OFF.WS)
        if ws > 0 and ws < 14 then
            memory.writef32(hum, OFF.WS, 16)
            memory.writef32(hum, OFF.WC, 16)
        end
    end

    -- Auto Heal
    if char and hum and TogStates.auto_heal and FrameN % 60 == 0 then
        if hum.Health < hum.MaxHealth * 0.6 then
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _,t in bp:GetChildren() do
                    local n = t.Name:lower()
                    if n:find("heal") or n:find("med") or n:find("bandage") then
                        t.Parent = char break
                    end
                end
            end
        end
    end

    -- Auto Armor
    if char and TogStates.auto_armor and FrameN % 60 == 0 then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _,t in bp:GetChildren() do
                local n = t.Name:lower()
                if n:find("armor") or n:find("vest") then t.Parent = char break end
            end
        end
    end

    -- Auto Pickup Cash
    if rp and TogStates.auto_pickup and FrameN % 30 == 0 then
        local ign = workspace:FindFirstChild("Ignored")
        if ign then
            for _,v in ign:GetChildren() do
                if v.Name:lower():find("cash") then
                    local ok,pos = pcall(function() return v.Position end)
                    if ok then
                        local d = v.Position - rp.Position
                        if math.sqrt(d.X*d.X+d.Y*d.Y+d.Z*d.Z) < SlVals.pickup_rng then
                            v.CFrame = rp.CFrame
                        end
                    end
                end
            end
        end
    end

    -- Vehicle keybinds
    if not CapturingKeybind then
        local carDown = HasKey(keys, CarFlyKey)
        if carDown and not WasCarKeyDown then TogStates.car_fly = not TogStates.car_fly Refresh() end
        WasCarKeyDown = carDown
        local bikeDown = HasKey(keys, BikeFlyKey)
        if bikeDown and not WasBikeKeyDown then TogStates.bike_fly = not TogStates.bike_fly Refresh() end
        WasBikeKeyDown = bikeDown
    end

    -- Keybind capture
    if CapturingKeybind then
        for _,k in keys do
            if k ~= "Insert" then
                if CapturingKeybind=="car" then CarFlyKey=k else BikeFlyKey=k end
                CapturingKeybind=nil Refresh() break
            end
        end
    end
end

-- Render Loop
RunService.Render:Connect(function()
    FrameN += 1
    local m = GetMouse()
    local ld = IsLeftDown()
    local jc = ld and not WasLeftDown
    local ks = GetKeys()

    if HasKey(ks,"Insert") and not WasInsertDown then
        MenuOpen = not MenuOpen
        if not MenuOpen then ShowSideMenu=nil end
        Refresh()
    end
    WasInsertDown = HasKey(ks,"Insert")

    DoLogic()

    if not MenuOpen then WasLeftDown=ld return end

    -- Scroll
    if Hit(m, PanelPos, PanelSz) then
        if HasKey(ks,"Up") and not WasUpDown then ScrollY=math.clamp(ScrollY-25,0,MaxScr) Refresh() end
        if HasKey(ks,"Down") and not WasDownDown then ScrollY=math.clamp(ScrollY+25,0,MaxScr) Refresh() end
    end
    WasUpDown = HasKey(ks,"Up")
    WasDownDown = HasKey(ks,"Down")

    -- Drag
    if Dragging and ld then PanelPos=m-DragOffset Refresh()
    elseif not ld then Dragging=false end

    if jc then
        -- Header drag
        if Hit(m, PanelPos, Vector2.new(PanelSz.X,35)) then
            local onTab = false
            for _,r in R.TabR or {} do if Hit(m,r.P,r.S) then onTab=true break end end
            if not onTab then Dragging=true DragOffset=m-PanelPos end
        end

        -- Tab clicks
        for i,r in R.TabR or {} do
            if Hit(m,r.P,r.S) then
                if ActiveTab ~= Tabs[i] then
                    ActiveTab=Tabs[i] ScrollY=0 ShowSideMenu=nil SelectedPlayer=nil Refresh()
                end
                break
            end
        end

        -- Player list clicks
        if ActiveTab=="Players" and R.PlayerBtns then
            for _,btn in R.PlayerBtns do
                if Hit(m,btn.P,btn.S) then
                    SelectedPlayer = btn.Player
                    ShowSideMenu = "_PLAYER_"
                    Refresh()
                    break
                end
            end
        end

        -- Profile action buttons
        if ShowSideMenu=="_PLAYER_" and R.ProfileBtns and SelectedPlayer then
            for _,btn in R.ProfileBtns do
                if Hit(m,btn.P,btn.S) then
                    local plr = SelectedPlayer
                    local k = btn.Key
                    if k=="spectate" then
                        local myHum = GetHum()
                        if workspace.CurrentCamera.CameraSubject ~= myHum then
                            workspace.CurrentCamera.CameraSubject = myHum
                        else
                            local th = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                            if th then workspace.CurrentCamera.CameraSubject = th end
                        end
                        Refresh()
                    elseif k=="goto" then
                        local rp = GetRP()
                        local th = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                        if rp and th then rp.CFrame = th.CFrame + Vector3.new(0,4,0) end
                    elseif k=="bring" then
                        local rp = GetRP()
                        local th = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                        if rp and th then th.CFrame = rp.CFrame + Vector3.new(3,0,0) end
                    elseif k=="fling" then
                        local th = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                        if th then
                            pcall(function()
                                th.Velocity = Vector3.new(math.random(-500,500), math.random(200,500), math.random(-500,500))
                            end)
                        end
                    elseif k=="kill" then
                        local th = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                        if th then pcall(function() memory.writef32(th, OFF.HP, 0) end) end
                    elseif k=="loopkill" then
                        if LoopKillTarget == plr then
                            LoopKillTarget = nil
                        else
                            LoopKillTarget = plr
                        end
                        Refresh()
                    elseif k=="copyname" then
                        pcall(function() setclipboard(plr.Name) end)
                    end
                    break
                end
            end
        end

        -- Normal content clicks
        for k,r in R.IR or {} do
            if Hit(m,r.P,r.S) then
                local it = r.I
                if it.Type=="Toggle" then
                    TogStates[k]=not TogStates[k] Refresh()
                elseif it.Type=="Slider" then
                    ActSlider=k
                elseif it.Type=="Keybind" then
                    local which = k=="car_fly_key" and "car" or "bike"
                    CapturingKeybind = CapturingKeybind==which and nil or which
                    Refresh()
                elseif it.Type=="Button" then
                    if k=="open_gun_buy" then
                        ShowSideMenu = ShowSideMenu=="Guns" and nil or "Guns"
                        Refresh()
                    elseif k=="tp_closest" then
                        local best,dist = nil,9999
                        local my = GetRP() and GetRP().Position
                        if my then
                            for _,p in Players:GetPlayers() do
                                if p~=LocalPlayer and p.Character then
                                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                                    if hrp then
                                        local d = hrp.Position-my
                                        local dm = math.sqrt(d.X*d.X+d.Y*d.Y+d.Z*d.Z)
                                        if dm<dist then dist=dm best=hrp end
                                    end
                                end
                            end
                            if best then GetRP().CFrame = best.CFrame+Vector3.new(0,4,0) end
                        end
                    elseif k=="tp_bank" then local r=GetRP() if r then r.CFrame=CFrame.new(-382,37,-837) end
                    elseif k=="tp_jewelry" then local r=GetRP() if r then r.CFrame=CFrame.new(148,18,-1674) end
                    elseif k=="tp_hospital" then local r=GetRP() if r then r.CFrame=CFrame.new(790,18,-643) end
                    elseif k=="tp_atm" then local r=GetRP() if r then r.CFrame=CFrame.new(-571,18,-250) end
                    else
                        local cats = {tp_guns="Guns", tp_ammo="Ammo", tp_food="Food", tp_tools="Tools"}
                        local mapped = cats[k]
                        if mapped then ShowSideMenu = ShowSideMenu==mapped and nil or mapped Refresh() end
                    end
                end
                break
            end
        end

        -- Teleport side menu clicks
        if ShowSideMenu and ShowSideMenu~="_PLAYER_" and R.SideBtns then
            for _,btn in R.SideBtns do
                if Hit(m,btn.P,btn.S) then
                    if ActiveTab=="Player" then
                        AutoBuyTarget = btn.Name
                        ShowSideMenu = nil
                        Refresh()
                    else
                        local rp = GetRP()
                        if rp then rp.CFrame = CFrame.new(btn.Pos) end
                    end
                end
            end
        end
    end

    -- Slider drag
    if ActSlider and ld then
        local r = R.IR[ActSlider]
        if r and r.bg then
            local pc = math.clamp((m.X-r.bg.Position.X)/r.bg.Size.X, 0, 1)
            SlVals[ActSlider] = math.floor(r.I.Min + pc*(r.I.Max-r.I.Min))
            Refresh()
        end
    elseif not ld then ActSlider=nil end

    WasLeftDown = ld
end)

Refresh()

