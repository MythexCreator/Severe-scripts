                    Make("Square",{Visible=true,Filled=true,Color=C.SlFl,Size=Vector2.new(sbg.Size.X*pc,5),Position=sbg.Position,ZIndex=107,Rounding=3})
                    R.IR[item.Key] = {P=Vector2.new(cX,sY), S=Vector2.new(cW,28), I=item, bg=sbg}

                elseif item.Type=="Button" then
                    local labelText = item.Name.."  →"
                    if item.Key=="open_gun_buy" and AutoBuyTarget then
                        labelText = "Gun: "..AutoBuyTarget.."  →"
                    end
                    Make("Square",{Visible=true,Filled=true,Color=C.Btn,Size=Vector2.new(cW,20),Position=Vector2.new(cX,sY),ZIndex=104,Rounding=4})
                    Make("Text",{Visible=true,Text=labelText,Size=12,Color=C.Wht,Position=Vector2.new(cX+8,sY+3),ZIndex=107,Outline=true})
                    R.IR[item.Key] = {P=Vector2.new(cX,sY), S=Vector2.new(cW,20), I=item}

                elseif item.Type=="Keybind" then
                    local isCar = item.Key=="car_fly_key"
                    local curKey = isCar and CarFlyKey or BikeFlyKey
                    local isCap = CapturingKeybind==(isCar and "car" or "bike")
                    Make("Text",{Visible=true,Text=item.Name,Size=12,Color=C.Txt,Position=Vector2.new(cX+5,sY+4),ZIndex=107,Outline=true})
                    local kbg = Make("Square",{Visible=true,Filled=true,Color=isCap and C.KeyOn or C.Btn,Size=Vector2.new(70,20),Position=Vector2.new(cX+cW-74,sY),ZIndex=107,Rounding=4})
