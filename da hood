local function Kill() ClearAll() R={} end
local function Refresh() Kill() if MenuOpen then Build() end end
local function Hit(p,rP,rS) return p.X>=rP.X and p.X<=rP.X+rS.X and p.Y>=rP.Y and p.Y<=rP.Y+rS.Y end
local function ForceReset()
    task.spawn(function()
        local hum = GetHum()
        if hum then pcall(function() memory.writef32(hum, OFF.HP, 0) end) end
    end)
end

local function HasGun(name)
    local char = GetChar()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if char then for _,v in char:GetChildren() do if v:IsA("Tool") and string.find(v.Name,name) then return true end end end
    if bp then for _,v in bp:GetChildren() do if v:IsA("Tool") and string.find(v.Name,name) then return true end end end
    return false
end

local function BuyItem(itemName)
    local rp = GetRP()
    local cam = workspace.CurrentCamera
    if not rp or not cam then return false end
    for _,v in workspace:GetDescendants() do
        if v:IsA("Model") and string.find(v.Name, itemName) then
            local head = v:FindFirstChild("Head")
            local cd = v:FindFirstChildOfClass("ClickDetector")
            if head and cd then
                local oldCF = rp.CFrame
                rp.CFrame = CFrame.new(head.Position + Vector3.new(0,2,0))
                task.wait(0.2)
                local sPos, onScr = cam:WorldToScreenPoint(head.Position)
                if onScr then
                    mousemoveabs(sPos.X, sPos.Y)
                    task.wait(0.1)
                    mouse1press()
                    task.wait(0.05)
                    mouse1release()
                    task.wait(0.2)
                end
                rp.CFrame = oldCF
                return true
            end
        end
    end
    return false
end

-- Vehicle Fly Loop
task.spawn(function()
    while true do
        task.wait(0.016)
        if not (TogStates.car_fly or TogStates.bike_fly) then continue end
        local keys = getpressedkeys()
        local cam = workspace.CurrentCamera
        if not cam then continue end
        local sName = TogStates.car_fly and "CarControlScript" or "ControlScript"
        local spd = (TogStates.car_fly and SlVals.car_fly_spd or SlVals.bike_fly_spd) * 15
        local scr = LocalPlayer.Backpack:FindFirstChild(sName)
        if scr then
            local obj = scr:FindFirstChild("Object")
            if obj and obj.Value then
                local veh = obj.Value
                local look = cam.LookVector
                local right = cam.RightVector
                local dx,dy,dz = 0,0,0
                for _,k in keys do
                    if k=="W" then dx=dx+look.X dy=dy+look.Y dz=dz+look.Z end
                    if k=="S" then dx=dx-look.X dy=dy-look.Y dz=dz-look.Z end
                    if k=="A" then dx=dx-right.X dy=dy-right.Y dz=dz-right.Z end
                    if k=="D" then dx=dx+right.X dy=dy+right.Y dz=dz+right.Z end
                    if k=="E" then dy=dy+1 end
                    if k=="Q" then dy=dy-1 end
                end
                local mag = math.sqrt(dx*dx+dy*dy+dz*dz)
                if mag > 0 then
                    pcall(function() veh.Velocity = Vector3.new(dx/mag*spd, dy/mag*spd, dz/mag*spd) end)
                else
                    pcall(function() veh.Velocity = Vector3.new(0,0,0) end)
                end
            end
        end
    end
end)

