    Make("Text",{Visible=true,Text="da hood",Size=11,Color=C.Dim,Position=PanelPos+Vector2.new(SideW/2,34),Center=true,Outline=true,OutlineColor=Vector3.new(0,0,0),Font=0,ZIndex=115})
    Make("Square",{Visible=true,Filled=true,Color=C.Brd,Size=Vector2.new(SideW-20,1),Position=PanelPos+Vector2.new(10,54),ZIndex=110})
    Make("Text",{Visible=true,Text="INSERT to hide",Size=9,Color=C.Dim,Position=PanelPos+Vector2.new(SideW/2,PanelSz.Y-14),Center=true,Font=0,ZIndex=115})

    -- Tabs
    R.TabR = {}
    for i,tn in Tabs do
        local y = PanelPos.Y+60+(i-1)*34
        local on = tn==ActiveTab
        Make("Square",{Visible=true,Filled=true,Color=on and C.TabOn or C.TabOff,Size=Vector2.new(SideW-16,28),Position=Vector2.new(PanelPos.X+8,y),ZIndex=105,Rounding=5})
        if on then Make("Square",{Visible=true,Filled=true,Color=C.Acc,Size=Vector2.new(3,20),Position=Vector2.new(PanelPos.X+8,y+4),ZIndex=106}) end
        Make("Text",{Visible=true,Text=tn,Size=12,Color=on and C.Wht or C.Dim,Position=Vector2.new(PanelPos.X+20,y+7),ZIndex=106,Outline=true})
        R.TabR[i] = {P=Vector2.new(PanelPos.X+8,y), S=Vector2.new(SideW-16,28)}
    end

    local cX = PanelPos.X+SideW+15
    local cW = PanelSz.X-SideW-30
    R.IR = {}
    R.PlayerBtns = {}
    local yPos = 0

    -- Players Tab
    if ActiveTab == "Players" then
        local playerList = Players:GetPlayers()
        local sY = cSY+yPos-ScrollY
        if sY+22 > cSY and sY < cSY+cH then
            Make("Square",{Visible=true,Filled=true,Color=C.Sec,Size=Vector2.new(cW,20),Position=Vector2.new(cX,sY),ZIndex=104,Rounding=3})
            Make("Text",{Visible=true,Text="ALL PLAYERS ("..tostring(#playerList)..")",Size=11,Color=C.Acc,Position=Vector2.new(cX+7,sY+4),ZIndex=107,Outline=true})
        end
        yPos += 26

        for idx, plr in playerList do
            if plr == LocalPlayer then continue end
            local pY = cSY+yPos-ScrollY
            if pY+24 > cSY and pY < cSY+cH then
                local isSelected = SelectedPlayer == plr
                Make("Square",{Visible=true,Filled=true,Color=isSelected and C.TabOn or C.Btn,Size=Vector2.new(cW,22),Position=Vector2.new(cX,pY),ZIndex=104,Rounding=4})
                local letter = plr.DisplayName:sub(1,1):upper()
                Make("Circle",{Visible=true,Filled=true,Color=C.Acc,Radius=8,Position=Vector2.new(cX+14,pY+11),ZIndex=106,NumSides=20})
                Make("Text",{Visible=true,Text=letter,Size=10,Color=C.Wht,Position=Vector2.new(cX+14,pY+5),Center=true,ZIndex=107,Outline=true})
                local displayText = plr.DisplayName.." ("..plr.Name..")"
                Make("Text",{Visible=true,Text=displayText,Size=11,Color=C.Txt,Position=Vector2.new(cX+28,pY+5),ZIndex=107,Outline=true})
                R.PlayerBtns[idx] = {P=Vector2.new(cX,pY), S=Vector2.new(cW,22), Player=plr}
            end
            yPos += 24
        end

    else
        -- Normal tabs
        for _, item in Opts[ActiveTab] or {} do
            local sY = cSY+yPos-ScrollY
            local iH = 22
            if item.Type=="Section" then iH=26
            elseif item.Type=="Slider" then iH=32 end

            if sY+iH > cSY and sY < cSY+cH then
                if item.Type=="Section" then
                    Make("Square",{Visible=true,Filled=true,Color=C.Sec,Size=Vector2.new(cW,20),Position=Vector2.new(cX,sY),ZIndex=104,Rounding=3})
                    Make("Text",{Visible=true,Text=item.Name:upper(),Size=11,Color=C.Acc,Position=Vector2.new(cX+7,sY+4),ZIndex=107,Outline=true})

                elseif item.Type=="Toggle" then
                    Make("Text",{Visible=true,Text=item.Name,Size=12,Color=C.Txt,Position=Vector2.new(cX+5,sY+4),ZIndex=107,Outline=true})
                    local on = TogStates[item.Key]
                    local tbg = Make("Square",{Visible=true,Filled=true,Color=on and C.TgOn or C.TgOff,Size=Vector2.new(30,14),Position=Vector2.new(cX+cW-36,sY+4),ZIndex=107,Rounding=7})
