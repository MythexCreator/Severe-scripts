local DC = {}
local function Make(cls, p)
    local o = Drawing.new(cls)
    if o and p then for k,v in p do o[k]=v end end
    table.insert(DC,o) return o
end
local function ClearAll() for _,o in DC do pcall(function() o:Remove() end) end table.clear(DC) end

