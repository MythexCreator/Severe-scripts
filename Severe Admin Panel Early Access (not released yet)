    local title=Drawing.new("Text")
    title.Visible=true title.Text=titleText title.Size=18
    title.Color=Theme.TextPrimary title.Outline=true
    title.Position=Vector2.new(px+55,py+Options.HEADER/2-10)
    table_insert(els,title)
    local tabY=py+Options.HEADER+10
    local tabs={{id="keybinds",label="Keybinds"},{id="theme",label="Theme"},{id="general",label="General"}}
    local tabWidth=(Options.W-Options.PAD*2-16)/3
    for i,tab in tabs do
        local tabX=px+Options.PAD+(i-1)*(tabWidth+8)
        local isSelected=Options.tab==tab.id
        local isThemeBlocked=(tab.id=="theme" and Settings.cuteMode)
        local tabBg=Drawing.new("Square")
        tabBg.Visible=true tabBg.Filled=true
        tabBg.Color=isSelected and (isThemeBlocked and Theme.Error or Theme.Accent) or Theme.Secondary
        tabBg.Rounding=6 tabBg.Position=Vector2.new(tabX,tabY) tabBg.Size=Vector2.new(tabWidth,Options.TAB_H)
        table_insert(els,tabBg)
        Options.tabBounds[tab.id]={pos=Vector2.new(tabX,tabY),size=Vector2.new(tabWidth,Options.TAB_H)}
        local tabLabel=isThemeBlocked and "Theme ✕" or tab.label
        local tabText=Drawing.new("Text")
        tabText.Visible=true tabText.Text=tostring(tabLabel) tabText.Size=12
        tabText.Color=isSelected and Color3.fromRGB(255,255,255) or (isThemeBlocked and Theme.Error or Theme.TextSecondary)
        tabText.Outline=true tabText.Center=true
        tabText.Position=Vector2.new(tabX+tabWidth/2,tabY+11)
        table_insert(els,tabText)
        if isThemeBlocked then
            local st=Drawing.new("Square")
            st.Visible=true st.Filled=true st.Color=Theme.Error
            st.Position=Vector2.new(tabX+10,tabY+Options.TAB_H/2)
            st.Size=Vector2.new(tabWidth-20,2)
            table_insert(els,st)
        end
    end
    local contentStartY=tabY+Options.TAB_H+15
    local contentEndY=py+Options.H-30
    local availableH=contentEndY-contentStartY
    if Options.tab=="keybinds" then
        Helpers.buildOptionsKeybindsTab(els,px,py,contentStartY,contentEndY)
    elseif Options.tab=="theme" then
        Helpers.buildOptionsThemeTab(els,px,py,contentStartY,availableH)
    elseif Options.tab=="general" then
        Helpers.buildOptionsGeneralTab(els,px,py,contentStartY,contentEndY)
    end
    local footerY=py+Options.H-25
    local footerLine=Drawing.new("Square")
    footerLine.Visible=true footerLine.Filled=true footerLine.Color=Theme.Border
    footerLine.Position=Vector2.new(px+Options.PAD,footerY) footerLine.Size=Vector2.new(Options.W-Options.PAD*2,1)
    table_insert(els,footerLine)
    local footerMsg=Settings.cuteMode and "Severe Admin v3.2 ♡" or "Severe Admin v3.2"
    local footerText=Drawing.new("Text")
    footerText.Visible=true footerText.Text=footerMsg footerText.Size=10
    footerText.Color=Theme.TextMuted footerText.Outline=true footerText.Center=true
    footerText.Position=Vector2.new(px+Options.W/2,footerY+6)
    table_insert(els,footerText)
    Options.needsRedraw=false
end

