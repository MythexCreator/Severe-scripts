                valueLabel.Color=isEditing and Color3.fromRGB(255,255,255) or Theme.TextPrimary
                valueLabel.Outline=true valueLabel.Center=true
                valueLabel.Position=Vector2.new(valueBoxX+valueBoxW/2,btnY+6)
                table_insert(els,valueLabel)
            end
            local isHold=currentMode=="hold"
            local modeBtn=Drawing.new("Square")
            modeBtn.Visible=true modeBtn.Filled=true modeBtn.Color=Theme.Tertiary
            modeBtn.Rounding=4 modeBtn.Position=Vector2.new(modeBtnX,btnY) modeBtn.Size=Vector2.new(modeBtnW,22)
            table_insert(els,modeBtn)
            local modeLabel=Drawing.new("Text")
            modeLabel.Visible=true modeLabel.Text=isHold and "HOLD" or "TOGGLE"
            modeLabel.Size=8 modeLabel.Color=Theme.TextPrimary modeLabel.Outline=true
            modeLabel.Center=true modeLabel.Position=Vector2.new(modeBtnX+modeBtnW/2,btnY+6)
            table_insert(els,modeLabel)
            local keyBtn=Drawing.new("Square")
            keyBtn.Visible=true keyBtn.Filled=true
            keyBtn.Color=isWaiting and Theme.Accent or Theme.Tertiary
            keyBtn.Rounding=4 keyBtn.Position=Vector2.new(keyBtnX,btnY) keyBtn.Size=Vector2.new(keyBtnW,22)
            table_insert(els,keyBtn)
            local keyLabel=Drawing.new("Text")
            keyLabel.Visible=true keyLabel.Text=tostring(keyText) keyLabel.Size=9
            keyLabel.Color=isWaiting and Color3.fromRGB(255,255,255) or Theme.TextPrimary
            keyLabel.Outline=true keyLabel.Center=true
            keyLabel.Position=Vector2.new(keyBtnX+keyBtnW/2,btnY+6)
            table_insert(els,keyLabel)
            local itemData={
                cmd=cmd,
                keyBounds={pos=Vector2.new(keyBtnX,btnY),size=Vector2.new(keyBtnW,22)},
                modeBounds={pos=Vector2.new(modeBtnX,btnY),size=Vector2.new(modeBtnW,22)},
                currentMode=currentMode,needsValue=needsValue,
            }
            if needsValue then
                itemData.valueBounds={pos=Vector2.new(valueBoxX,btnY),size=Vector2.new(valueBoxW,22)}
            end
            table_insert(Options.keybindItems,itemData)
        end
    end
    if maxScroll>0 then
        local scrollbarX=px+Options.W-Options.PAD-8
        local scrollbarY=itemsStartY
        local scrollbarH=contentH
        local thumbH=math.max(30,scrollbarH*(Options.VISIBLE/#items))
        local thumbY=scrollbarY+(Options.scrollOffset/maxScroll)*(scrollbarH-thumbH)
        local scrollTrack=Drawing.new("Square")
        scrollTrack.Visible=true scrollTrack.Filled=true scrollTrack.Color=Theme.Tertiary
        scrollTrack.Rounding=3 scrollTrack.Position=Vector2.new(scrollbarX,scrollbarY) scrollTrack.Size=Vector2.new(6,scrollbarH)
        table_insert(els,scrollTrack)
        local scrollThumb=Drawing.new("Square")
        scrollThumb.Visible=true scrollThumb.Filled=true scrollThumb.Color=Theme.Accent
        scrollThumb.Rounding=3 scrollThumb.Position=Vector2.new(scrollbarX,thumbY) scrollThumb.Size=Vector2.new(6,thumbH)
        table_insert(els,scrollThumb)
        Options.scrollBounds={
            pos=Vector2.new(scrollbarX,scrollbarY),
            size=Vector2.new(6,scrollbarH),
            thumbH=thumbH,maxScroll=maxScroll,contentH=contentH
        }
    else
        Options.scrollBounds=nil
    end
end

Helpers.buildOptionsThemeTab = function(els,px,py,contentStartY,availableH)
    if Settings.cuteMode then
        local blockedMsg=Drawing.new("Text")
        blockedMsg.Visible=true blockedMsg.Text="♡ Theme is locked in Cute Mode ♡"
        blockedMsg.Size=16 blockedMsg.Color=Theme.TextPrimary blockedMsg.Outline=true
        blockedMsg.Center=true blockedMsg.Position=Vector2.new(px+Options.W/2,contentStartY+40)
        table_insert(els,blockedMsg)
        local blockedHint=Drawing.new("Text")
        blockedHint.Visible=true blockedHint.Text="Disable Cute Mode in General to change theme"
        blockedHint.Size=11 blockedHint.Color=Theme.TextSecondary blockedHint.Outline=true
        blockedHint.Center=true blockedHint.Position=Vector2.new(px+Options.W/2,contentStartY+65)
        table_insert(els,blockedHint)
        local kittyDeco=Drawing.new("Text")
        kittyDeco.Visible=true kittyDeco.Text="◕‿◕  ♡  ʕ•ᴥ•ʔ"
        kittyDeco.Size=18 kittyDeco.Color=Theme.AccentLight kittyDeco.Outline=true
        kittyDeco.Center=true kittyDeco.Position=Vector2.new(px+Options.W/2,contentStartY+100)
        table_insert(els,kittyDeco)
        return
    end
    local subTabY=contentStartY
    local subTabs={{id="accent",label="Accent Colors"},{id="fill",label="Background Colors"}}
    local subTabW=(Options.W-Options.PAD*2-8)/2
    for i,subTab in subTabs do
        local subTabX=px+Options.PAD+(i-1)*(subTabW+8)
        local isSelected=Options.themeTab==subTab.id
        local subTabBg=Drawing.new("Square")
        subTabBg.Visible=true subTabBg.Filled=true
        subTabBg.Color=isSelected and Theme.Tertiary or Theme.Secondary
        subTabBg.Rounding=4 subTabBg.Position=Vector2.new(subTabX,subTabY) subTabBg.Size=Vector2.new(subTabW,28)
        table_insert(els,subTabBg)
        Options.tabBounds["theme_"..subTab.id]={pos=Vector2.new(subTabX,subTabY),size=Vector2.new(subTabW,28)}
        local subTabText=Drawing.new("Text")
        subTabText.Visible=true subTabText.Text=tostring(subTab.label) subTabText.Size=11
        subTabText.Color=isSelected and Theme.TextPrimary or Theme.TextSecondary
        subTabText.Outline=true subTabText.Center=true
        subTabText.Position=Vector2.new(subTabX+subTabW/2,subTabY+8)
        table_insert(els,subTabText)
    end
    local gridStartY=subTabY+40
    local gridH=availableH-50
    local itemW,itemH,gapTheme=95,50,8
    local cols=math.max(4,math_floor((Options.W-Options.PAD*2-12)/(itemW+gapTheme)))
    local scrollbarWidth=12
    local gridContentW=Options.W-Options.PAD*2-scrollbarWidth
    local presets=Options.themeTab=="accent" and accentPresets or fillPresets
    local rows=math.ceil(#presets/cols)
    local totalGridH=rows*(itemH+gapTheme)-gapTheme
    local maxThemeScroll=math.max(0,totalGridH-gridH)
    Options.themeScroll=math_clamp(Options.themeScroll,0,maxThemeScroll)
    Options.themeScrollBounds={
        pos=Vector2.new(px+Options.PAD,gridStartY),
        size=Vector2.new(gridContentW+scrollbarWidth,gridH),
        maxScroll=maxThemeScroll,gridY=gridStartY,gridH=gridH
    }
    if Options.themeTab=="accent" then
        Options.themeItems={}
        for i,preset in accentPresets do
            local col=(i-1)%cols
            local row=math_floor((i-1)/cols)
            local itemX=px+Options.PAD+col*(itemW+gapTheme)
            local itemYPos=gridStartY+row*(itemH+gapTheme)-Options.themeScroll
            if itemYPos+itemH>gridStartY and itemYPos<gridStartY+gridH then
                local isSelected=(
                    math_floor(Theme.Accent.R*255)==math_floor(preset.accent.R*255) and
                    math_floor(Theme.Accent.G*255)==math_floor(preset.accent.G*255) and
                    math_floor(Theme.Accent.B*255)==math_floor(preset.accent.B*255)
                )
                local bg=Drawing.new("Square")
                bg.Visible=true bg.Filled=true
                bg.Color=isSelected and Theme.Tertiary or Theme.Card
                bg.Rounding=6 bg.Position=Vector2.new(itemX,itemYPos) bg.Size=Vector2.new(itemW,itemH)
                table_insert(els,bg)
                if isSelected then
                    local selBorder=Drawing.new("Square")
                    selBorder.Visible=true selBorder.Filled=false selBorder.Color=preset.accent
                    selBorder.Rounding=6 selBorder.Thickness=2
                    selBorder.Position=Vector2.new(itemX,itemYPos) selBorder.Size=Vector2.new(itemW,itemH)
                    table_insert(els,selBorder)
                end
                local preview=Drawing.new("Square")
                preview.Visible=true preview.Filled=true preview.Color=preset.accent
                preview.Rounding=4 preview.Position=Vector2.new(itemX+6,itemYPos+6) preview.Size=Vector2.new(itemW-12,22)
                table_insert(els,preview)
                local nameText=Drawing.new("Text")
                nameText.Visible=true nameText.Text=tostring(preset.name) nameText.Size=8
                nameText.Color=Theme.TextSecondary nameText.Outline=true nameText.Center=true
                nameText.Position=Vector2.new(itemX+itemW/2,itemYPos+34)
                table_insert(els,nameText)
                table_insert(Options.themeItems,{preset=preset,bounds={pos=Vector2.new(itemX,itemYPos),size=Vector2.new(itemW,itemH)}})
            end
        end
    else
        Options.fillItems={}
        for i,preset in fillPresets do
            local col=(i-1)%cols
            local row=math_floor((i-1)/cols)
            local itemX=px+Options.PAD+col*(itemW+gapTheme)
            local itemYPos=gridStartY+row*(itemH+gapTheme)-Options.themeScroll
            if itemYPos+itemH>gridStartY and itemYPos<gridStartY+gridH then
                local isSelected=(
                    math_floor(Theme.Primary.R*255)==math_floor(preset.primary.R*255) and
                    math_floor(Theme.Primary.G*255)==math_floor(preset.primary.G*255) and
                    math_floor(Theme.Primary.B*255)==math_floor(preset.primary.B*255)
                )
                local bg=Drawing.new("Square")
                bg.Visible=true bg.Filled=true
                bg.Color=isSelected and Theme.Tertiary or Theme.Card
                bg.Rounding=6 bg.Position=Vector2.new(itemX,itemYPos) bg.Size=Vector2.new(itemW,itemH)
                table_insert(els,bg)
                if isSelected then
                    local selBorder=Drawing.new("Square")
                    selBorder.Visible=true selBorder.Filled=false selBorder.Color=Theme.Accent
                    selBorder.Rounding=6 selBorder.Thickness=2
                    selBorder.Position=Vector2.new(itemX,itemYPos) selBorder.Size=Vector2.new(itemW,itemH)
                    table_insert(els,selBorder)
                end
                local pw=(itemW-12)/3
                local p1=Drawing.new("Square") p1.Visible=true p1.Filled=true p1.Color=preset.primary
                p1.Rounding=4 p1.Position=Vector2.new(itemX+6,itemYPos+6) p1.Size=Vector2.new(pw,22)
                table_insert(els,p1)
                local p2=Drawing.new("Square") p2.Visible=true p2.Filled=true p2.Color=preset.secondary
                p2.Position=Vector2.new(itemX+6+pw,itemYPos+6) p2.Size=Vector2.new(pw,22)
                table_insert(els,p2)
                local p3=Drawing.new("Square") p3.Visible=true p3.Filled=true p3.Color=preset.tertiary
