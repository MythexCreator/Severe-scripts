        local isAliveNow=currentHealth>0
        if isAliveNow and root then DiedTp.lastPos=root.Position end
        if DiedTp.wasAliveLastFrame and not isAliveNow then
            if DiedTp.lastPos then DiedTp.deathPos=DiedTp.lastPos end
            DiedTp.wasDead=true
        end
        if DiedTp.wasDead and isAliveNow and DiedTp.deathPos then
            local savedPos=DiedTp.deathPos
            task.spawn(function()
                task.wait(0.15)
                if savedPos then
                    doTeleport(savedPos+Vector3.new(0,3,0),true)
                    notify("But it refused.")
                end
            end)
            DiedTp.wasDead=false DiedTp.deathPos=nil DiedTp.cooldown=2
        end
        DiedTp.lastHealth=currentHealth DiedTp.wasAliveLastFrame=isAliveNow
    end)
end

Helpers.setSpawnpoint = function()
    local char=LocalPlayer.Character
    if not char then notify("No character") return end
    local root=char:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then notify("No HumanoidRootPart") return end
    Spawnpoint.position=root.Position+Vector3.new(0,0.5,0)
    Spawnpoint.cframe=root.CFrame Spawnpoint.enabled=true
    Spawnpoint.wasDead=false Spawnpoint.wasAliveLastFrame=true Spawnpoint.cooldown=0
    local hum=char:FindFirstChildOfClass("Humanoid")
    Spawnpoint.lastHealth=hum and hum.Health or 100
    KeybindsGui.needsRedraw=true notify("Spawnpoint set!")
end

Helpers.clearSpawnpoint = function()
    Spawnpoint.enabled=false Spawnpoint.position=nil Spawnpoint.cframe=nil Spawnpoint.wasDead=false
    KeybindsGui.needsRedraw=true notify("Spawnpoint cleared")
end

Helpers.updateSpawnpoint = function(dt)
    if not Spawnpoint.enabled or not Spawnpoint.position then return end
    if Spawnpoint.cooldown>0 then Spawnpoint.cooldown=Spawnpoint.cooldown-dt return end
    pcall(function()
        local char=LocalPlayer.Character
        if not char then Spawnpoint.wasDead=true Spawnpoint.wasAliveLastFrame=false return end
        local root=char:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then Spawnpoint.wasDead=true Spawnpoint.wasAliveLastFrame=false return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local currentHealth=hum.Health
        local isAliveNow=currentHealth>0
        if Spawnpoint.wasAliveLastFrame and not isAliveNow then Spawnpoint.wasDead=true end
        if Spawnpoint.wasDead and isAliveNow then
            local savedPos=Spawnpoint.position
            task.spawn(function()
                task.wait(0.15)
                if savedPos then doTeleport(savedPos,true) notify("Respawn → Spawnpoint") end
            end)
            Spawnpoint.wasDead=false Spawnpoint.cooldown=2
        end
        Spawnpoint.lastHealth=currentHealth Spawnpoint.wasAliveLastFrame=isAliveNow
    end)
end

Helpers.forceReset = function()
    local char=LocalPlayer.Character
    if not char then notify("No character") return end
    task.spawn(function()
        local success=false
        pcall(function()
            local hum=char:FindFirstChildOfClass("Humanoid")
            if hum then memory.writef32(hum,Offsets.Health,0) success=true end
        end)
        if not success then
            pcall(function()
                local hum=char:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health=0 success=true end
            end)
        end
        if not success then
            pcall(function()
                local root=char:FindFirstChild("HumanoidRootPart")
                if root then root.CFrame=CFrame.new(0,-500,0) success=true end
            end)
        end
        if success then notify("Force reset!") else notify("Force reset failed") end
    end)
end

Helpers.getUserId = function(name)
    if not name then
        local userId=LocalPlayer.UserId
        pcall(function() setclipboard(tostring(userId)) end)
        notify("Your UserId: "..tostring(userId).." (copied)")
        return
    end
    local player=resolvePlayerArg(name)
    if not player then notify("Player not found: "..tostring(name)) return end
    local userId=player.UserId
    pcall(function() setclipboard(tostring(userId)) end)
    notify(tostring(player.Name).."'s UserId: "..tostring(userId).." (copied)")
end

-- LOOP naprawiony: ;loop times delay cmd [args...]
Helpers.loopCommand = function(args)
    if #args<2 then notify("Usage: ;loop [times] [delay] [command] [args]") return end
    local times=tonumber(args[1])
    if not times or times<1 then notify("Invalid times value") return end
    times=math_clamp(math_floor(times),1,1000)
    local delay=tonumber(args[2]) or 0
    if #args<3 then notify("No command specified") return end
    local cmdParts={}
    for i=3,#args do table_insert(cmdParts,args[i]) end
    local cmd=table.concat(cmdParts," ")
    if string_sub(cmd,1,1)~=";" then cmd=";"..cmd end
    notify("Loop: "..tostring(times).."x '"..cmd.."' delay="..tostring(delay).."s")
    task.spawn(function()
        for i=1,times do
            runCmd(cmd)
            if delay>0 then task.wait(delay) end
        end
        notify("Loop finished ("..tostring(times).."x)")
    end)
end

