            tagText.Color=Color3.fromRGB(255,255,255) tagText.Outline=true tagText.Center=true
            tagText.Position=Vector2.new(contentX+10+tagW/2,itemY+11)
            table_insert(els,tagText)
            local cmdNameT=Drawing.new("Text")
