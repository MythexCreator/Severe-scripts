        scrollThumb.Rounding=4 scrollThumb.Position=Vector2.new(scrollbarX,thumbY) scrollThumb.Size=Vector2.new(8,thumbH)
        table_insert(els,scrollThumb)
        CommandPanelDrawing.scrollBounds={
            pos=Vector2.new(scrollbarX,scrollbarY),
            size=Vector2.new(8,scrollbarH),
            thumbH=thumbH,maxScroll=maxScroll,contentH=contentH
        }
    else
        CommandPanelDrawing.scrollBounds=nil
    end
    local resizeX=px+W-20
    local resizeY=py+H-20
    local resizeHandle=Drawing.new("Triangle")
    resizeHandle.Visible=true resizeHandle.Filled=true resizeHandle.Color=Theme.Accent resizeHandle.Opacity=0.5
    resizeHandle.PointA=Vector2.new(resizeX+20,resizeY)
    resizeHandle.PointB=Vector2.new(resizeX+20,resizeY+20)
    resizeHandle.PointC=Vector2.new(resizeX,resizeY+20)
