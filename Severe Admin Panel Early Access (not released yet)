local function getPlayerSuggestions(partial)
    local suggestions={}
    local specials={
        {name="random",displayName="Random Player"},
        {name="nearest",displayName="Nearest Player"},
        {name="farthest",displayName="Farthest Player"},
    }
    if not partial or partial=="" then
        for _,s in specials do table_insert(suggestions,s) end
        for _,p in Players:GetChildren() do
            if p~=LocalPlayer then
                table_insert(suggestions,{name=p.Name,displayName=p.DisplayName})
                if #suggestions>=8 then break end
            end
        end
    else
        local n=string_lower(partial)
        for _,s in specials do
            if string_find(string_lower(s.name),n,1,true)==1 then
                table_insert(suggestions,s)
            end
        end
        for _,p in Players:GetChildren() do
            if p~=LocalPlayer then
                if string_find(string_lower(p.Name),n,1,true)==1
                    or string_find(string_lower(p.DisplayName),n,1,true)==1 then
                    table_insert(suggestions,{name=p.Name,displayName=p.DisplayName})
                    if #suggestions>=8 then break end
                end
            end
        end
    end
    return suggestions
end

local function parseCommandForPlayerArg(input)
    local clean=string_gsub(input,"^;","")
    local parts={}
    for p in string.gmatch(clean,"%S+") do table_insert(parts,p) end
    if #parts==0 then return nil,nil end
    local cmdName=string_lower(parts[1])
    local playerCmds={tp=true,view=true,userid=true}
    if playerCmds[cmdName] then return cmdName,parts[2] or "" end
    return nil,nil
end

-- Loop parser: ;loop times delay cmd [playerarg]
local function parseLoopForPlayerArg(input)
    local clean=string_gsub(input,"^;","")
    local parts={}
    for p in string.gmatch(clean,"%S+") do table_insert(parts,p) end
    -- parts[1]=loop, parts[2]=times, parts[3]=delay, parts[4]=cmd, parts[5]=playerarg
    if #parts<4 then return nil,nil end
    if string_lower(parts[1])~="loop" then return nil,nil end
    local innerCmd=string_lower(parts[4])
    local playerCmds={tp=true,view=true,userid=true}
    if playerCmds[innerCmd] then
        return innerCmd,parts[5] or ""
    end
    return nil,nil
end

-- Bar input parser: detectuje czy potrzebujemy autocomplete
-- zwraca: "player", cmdName, partial | "animation", partial | "command", partial | nil
local function parseBarInputForSuggestions(input)
    local clean=string_gsub(input,"^;","")
    local parts={}
    for p in string.gmatch(clean,"%S+") do table_insert(parts,p) end
    if #parts==0 then return nil,nil,nil end
    local cmd1=string_lower(parts[1])

    -- ;tp partial | ;view partial | ;userid partial
    local playerCmds={tp=true,view=true,userid=true}
    if playerCmds[cmd1] and #parts>=2 then
        return "player",cmd1,parts[2]
    end
    -- jeszcze wpisujemy komendę (brak spacji)
    if #parts==1 and not string_find(clean," ") then
        return "command",nil,parts[1]
    end

    -- ;animation partial
    if cmd1=="animation" then
        return "animation",nil,parts[2] or ""
    end

    -- ;loop times delay cmd [playerarg]
    if cmd1=="loop" then
        if #parts==4 then
            -- wpisujemy nazwę komendy (4. argument)
            return "command","loop",parts[4]
        elseif #parts>=5 then
            local innerCmd=string_lower(parts[4])
            if playerCmds[innerCmd] then
                return "player",innerCmd,parts[5] or ""
            end
        elseif #parts<4 then
            -- wpisujemy jeszcze loop args, pokaż sugestie komend jeśli na 3. pozycji
            if #parts==3 then
                return "command","loop",parts[3]
            end
        end
    end

    return nil,nil,nil
end

local function cacheSpawnLocation()
