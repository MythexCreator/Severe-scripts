Helpers.getOptionsFiltered = function()
    if Options.searchQuery==Options.lastSearchQuery and #Options.filteredCache>0 then
        return Options.filteredCache
    end
    Options.filteredCache={}
    local q=string_lower(Options.searchQuery)
    for _,c in commands do
        if bindableCommands[c.name] then
            if q=="" or string_find(string_lower(c.name),q,1,true)
                or string_find(string_lower(c.desc),q,1,true)
                or string_find(string_lower(c.cat),q,1,true) then
                table_insert(Options.filteredCache,c)
            end
        end
    end
    Options.lastSearchQuery=Options.searchQuery
    return Options.filteredCache
end

Helpers.optionsMaxScroll = function()
    return math.max(0,#Helpers.getOptionsFiltered()-Options.VISIBLE)
end

Helpers.smoothScroll = function(current,target,dt)
    local diff=target-current
    if math_abs(diff)<0.01 then return target end
    return current+diff*math_clamp(dt*15,0,1)
end

Helpers.getFilteredPanelCommands = function()
    local filtered={}
    local query=string_lower(CommandPanel.searchQuery)
    for _,cmd in commandsForPanel do
        local matchesCategory=(CommandPanel.selectedCategory=="ALL" or cmd.cat==CommandPanel.selectedCategory)
        local matchesSearch=true
        if query~="" then
            matchesSearch=string_find(string_lower(cmd.name),query,1,true)
                or string_find(string_lower(cmd.desc),query,1,true)
                or string_find(string_lower(cmd.cat),query,1,true)
        end
        if matchesCategory and matchesSearch then table_insert(filtered,cmd) end
    end
    return filtered
end

