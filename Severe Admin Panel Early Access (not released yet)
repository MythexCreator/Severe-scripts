local InputBlock = { active=false, savedWalkSpeed=16, savedJumpPower=50, freezeCounter=0 }

local function inputBlockGetHumanoid()
    local char=LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function inputBlockSaveStats()
    pcall(function()
        local hum=inputBlockGetHumanoid()
        if not hum then return end
        local ws=memory.readf32(hum,Offsets.WalkSpeed)
        local jp=memory.readf32(hum,Offsets.JumpPower)
        if ws and ws>0 and ws<1000 then InputBlock.savedWalkSpeed=ws end
        if jp and jp>0 and jp<1000 then InputBlock.savedJumpPower=jp end
    end)
end

local function inputBlockFreezeCharacter()
    pcall(function()
        local hum=inputBlockGetHumanoid()
        if not hum then return end
        pcall(function() hum.WalkSpeed=0 end)
        pcall(function() hum.JumpPower=0 end)
    end)
end

local function inputBlockUnfreezeCharacter()
    pcall(function()
        local hum=inputBlockGetHumanoid()
        if not hum then return end
        local rWS=Features.walkSpeedEnabled and Features.walkSpeedValue or InputBlock.savedWalkSpeed
        local rJP=Features.jumpPowerEnabled and Features.jumpPowerValue or InputBlock.savedJumpPower
        pcall(function() hum.WalkSpeed=rWS end)
        pcall(function() hum.JumpPower=rJP end)
    end)
end

local function inputBlockActivate()
    if InputBlock.active then return end
    if not Settings.inputBlockEnabled then return end
    inputBlockSaveStats()
    inputBlockFreezeCharacter()
    InputBlock.active=true
    InputBlock.freezeCounter=0
end

local function inputBlockDeactivate()
    if not InputBlock.active then return end
    inputBlockUnfreezeCharacter()
    InputBlock.active=false
end

local function inputBlockUpdate()
    if not InputBlock.active then return end
    if not Settings.inputBlockEnabled then inputBlockDeactivate() return end
    InputBlock.freezeCounter=InputBlock.freezeCounter+1
    if InputBlock.freezeCounter>=15 then
        InputBlock.freezeCounter=0
        inputBlockFreezeCharacter()
    end
end

