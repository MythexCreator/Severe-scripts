local function color3ToTable(c)
    if not c then return nil end
    return {r=math_floor(c.R*255),g=math_floor(c.G*255),b=math_floor(c.B*255)}
end

local function tableToColor3(t)
    if not t or t.r==nil then return nil end
    return Color3.fromRGB(t.r,t.g,t.b)
end

local function saveSettings()
    if not Settings.autoSaveEnabled then return end
    local sc=Settings.saveCategories
    local data={
        version="3.2",
        settings=sc.general and {
            commandBarKey=Settings.commandBarKey,scrollSpeed=Settings.scrollSpeed,
            statusBarEnabled=Settings.statusBarEnabled,statusBarCorner=Settings.statusBarCorner,
            statusBarOrientation=Settings.statusBarOrientation,hideUsername=Settings.hideUsername,
            watermarkEnabled=Settings.watermarkEnabled,autoSaveEnabled=Settings.autoSaveEnabled,
            cuteMode=Settings.cuteMode,inputBlockEnabled=Settings.inputBlockEnabled,
            saveCategories=Settings.saveCategories,
        } or nil,
        theme=sc.theme and {
            accent=color3ToTable(Theme.Accent),accentLight=color3ToTable(Theme.AccentLight),
            accentDark=color3ToTable(Theme.AccentDark),primary=color3ToTable(Theme.Primary),
            secondary=color3ToTable(Theme.Secondary),tertiary=color3ToTable(Theme.Tertiary),
            card=color3ToTable(Theme.Card),border=color3ToTable(Theme.Border),
        } or nil,
        preCuteTheme=PreCuteTheme and sc.theme and {
            accent=color3ToTable(PreCuteTheme.Accent),accentLight=color3ToTable(PreCuteTheme.AccentLight),
            accentDark=color3ToTable(PreCuteTheme.AccentDark),primary=color3ToTable(PreCuteTheme.Primary),
            secondary=color3ToTable(PreCuteTheme.Secondary),tertiary=color3ToTable(PreCuteTheme.Tertiary),
            card=color3ToTable(PreCuteTheme.Card),border=color3ToTable(PreCuteTheme.Border),
            textPrimary=color3ToTable(PreCuteTheme.TextPrimary),
            textSecondary=color3ToTable(PreCuteTheme.TextSecondary),
            textMuted=color3ToTable(PreCuteTheme.TextMuted),
        } or nil,
        positions=sc.positions and {
            watermarkX=Watermark.posX,watermarkY=Watermark.posY,
            keybindsGuiX=KeybindsGui.posX,keybindsGuiY=KeybindsGui.posY,
            optionsX=Options.posX,optionsY=Options.posY,
            commandPanelX=CommandPanel.posX,commandPanelY=CommandPanel.posY,
            commandPanelW=CommandPanelDrawing.W,commandPanelH=CommandPanelDrawing.H,
            coordsDisplayX=CoordsDisplay.posX,coordsDisplayY=CoordsDisplay.posY,
        } or nil,
        keybinds=sc.keybinds and {
            binds=Keybinds.binds,modes=Keybinds.modes,keybindValues=Options.keybindValues,
        } or nil,
        commands=sc.commands and {
            noclip=Features.noclipEnabled,infjump=Features.infJumpEnabled,
            antivoid=Features.antiVoidEnabled,diedtp=DiedTp.enabled,
            thirdperson=Features.thirdPersonEnabled,fov=Features.fovEnabled,
            fovValue=Features.currentFovValue,headless=Features.headlessEnabled,
            walkspeed=Features.walkSpeedEnabled,walkspeedValue=Features.walkSpeedValue,
            jumppower=Features.jumpPowerEnabled,jumppowerValue=Features.jumpPowerValue,
        } or nil,
    }
    local ok,enc=pcall(function() return crypt.json.encode(data) end)
    if ok and enc then pcall(function() writefile(SETTINGS_FILE,enc) end) end
end

local function loadSettingsFromFile()
    local ok,content=pcall(function() return readfile(SETTINGS_FILE) end)
    if not ok or not content then return nil end
    local ok2,data=pcall(function() return crypt.json.decode(content) end)
    if not ok2 or not data then return nil end
    return data
end

local function applyThemeFromTable(t)
    local function trySet(key,field)
        local c=tableToColor3(t[field])
        if c then Theme[key]=c end
    end
    trySet("Accent","accent") trySet("AccentLight","accentLight") trySet("AccentDark","accentDark")
    trySet("Primary","primary") trySet("Secondary","secondary") trySet("Tertiary","tertiary")
    trySet("Card","card") trySet("Border","border")
end

local function applySettingsData(data)
    if not data then return end
    if data.settings then
        local s=data.settings
        if s.commandBarKey then Settings.commandBarKey=s.commandBarKey end
        if s.scrollSpeed then Settings.scrollSpeed=s.scrollSpeed end
        if s.statusBarEnabled~=nil then Settings.statusBarEnabled=s.statusBarEnabled end
        if s.statusBarCorner then Settings.statusBarCorner=s.statusBarCorner end
        if s.statusBarOrientation then Settings.statusBarOrientation=s.statusBarOrientation end
        if s.hideUsername~=nil then Settings.hideUsername=s.hideUsername end
        if s.watermarkEnabled~=nil then Settings.watermarkEnabled=s.watermarkEnabled end
        if s.autoSaveEnabled~=nil then Settings.autoSaveEnabled=s.autoSaveEnabled end
        if s.cuteMode~=nil then Settings.cuteMode=s.cuteMode end
        if s.inputBlockEnabled~=nil then Settings.inputBlockEnabled=s.inputBlockEnabled end
        if s.saveCategories then
            for k,v in pairs(s.saveCategories) do Settings.saveCategories[k]=v end
        end
    end
    if data.theme then applyThemeFromTable(data.theme) end
    if data.preCuteTheme then
        PreCuteTheme={}
        local t=data.preCuteTheme
        PreCuteTheme.Accent=tableToColor3(t.accent) or DefaultTheme.Accent
        PreCuteTheme.AccentLight=tableToColor3(t.accentLight) or DefaultTheme.AccentLight
        PreCuteTheme.AccentDark=tableToColor3(t.accentDark) or DefaultTheme.AccentDark
        PreCuteTheme.Primary=tableToColor3(t.primary) or DefaultTheme.Primary
        PreCuteTheme.Secondary=tableToColor3(t.secondary) or DefaultTheme.Secondary
        PreCuteTheme.Tertiary=tableToColor3(t.tertiary) or DefaultTheme.Tertiary
        PreCuteTheme.Card=tableToColor3(t.card) or DefaultTheme.Card
        PreCuteTheme.Border=tableToColor3(t.border) or DefaultTheme.Border
        PreCuteTheme.TextPrimary=tableToColor3(t.textPrimary) or DefaultTheme.TextPrimary
        PreCuteTheme.TextSecondary=tableToColor3(t.textSecondary) or DefaultTheme.TextSecondary
        PreCuteTheme.TextMuted=tableToColor3(t.textMuted) or DefaultTheme.TextMuted
    end
    if data.positions then
        local p=data.positions
        if p.watermarkX~=nil then Watermark.posX=p.watermarkX end
        if p.watermarkY~=nil then Watermark.posY=p.watermarkY end
        if p.keybindsGuiX~=nil then KeybindsGui.posX=p.keybindsGuiX end
        if p.keybindsGuiY~=nil then KeybindsGui.posY=p.keybindsGuiY end
        if p.optionsX~=nil then Options.posX=p.optionsX end
        if p.optionsY~=nil then Options.posY=p.optionsY end
        if p.commandPanelX~=nil then CommandPanel.posX=p.commandPanelX end
        if p.commandPanelY~=nil then CommandPanel.posY=p.commandPanelY end
        if p.commandPanelW~=nil then CommandPanelDrawing.W=math_clamp(p.commandPanelW,CommandPanelDrawing.minW,CommandPanelDrawing.maxW) end
        if p.commandPanelH~=nil then CommandPanelDrawing.H=math_clamp(p.commandPanelH,CommandPanelDrawing.minH,CommandPanelDrawing.maxH) end
        if p.coordsDisplayX~=nil then CoordsDisplay.posX=p.coordsDisplayX end
        if p.coordsDisplayY~=nil then CoordsDisplay.posY=p.coordsDisplayY end
    end
    if data.keybinds then
        if data.keybinds.binds then Keybinds.binds=data.keybinds.binds end
        if data.keybinds.modes then Keybinds.modes=data.keybinds.modes end
        if data.keybinds.keybindValues then Options.keybindValues=data.keybinds.keybindValues end
    end
    if Settings.cuteMode then for k,v in pairs(CuteTheme) do Theme[k]=v end end
end

local function loadSettings()
    if State.settingsLoaded then return end
    local data=loadSettingsFromFile()
    if data then applySettingsData(data) end
    State.settingsLoaded=true
    Watermark.initialized=false
end

local function revertToLastSave()
