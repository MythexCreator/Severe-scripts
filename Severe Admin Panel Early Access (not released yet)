Helpers.createBar = function()
    clearBar()
    local cam=workspace.CurrentCamera
    if not cam then return end
    local vw,vh=cam.ViewportSize.X,cam.ViewportSize.Y

    -- Analizuj input żeby pokazać odpowiednie sugestie
    local suggestType,suggestCmd,suggestPartial=parseBarInputForSuggestions(Bar.input)

    Bar.acResults={}
    Bar.playerSuggestions={}
    Bar.showingPlayerSuggestions=false

    if suggestType=="player" then
        Bar.playerSuggestions=getPlayerSuggestions(suggestPartial)
        Bar.showingPlayerSuggestions=#Bar.playerSuggestions>0
    elseif suggestType=="animation" then
        local argLower=string_lower(suggestPartial or "")
        for _,packName in AnimationPackOrder do
            if argLower=="" or string_find(string_lower(packName),argLower,1,true)==1 then
                table_insert(Bar.acResults,{
                    name="animation "..packName,
                    desc="Apply "..packName.." animations",
                    cat="Fun",
                    usage=";animation "..packName,
                    isAnimPack=true,
                    packName=packName,
                })
                if #Bar.acResults>=6 then break end
            end
        end
    elseif suggestType=="command" then
        local partial=string_lower(suggestPartial or "")
        for _,cmd in commands do
            if partial=="" or string_find(string_lower(cmd.name),partial,1,true)==1 then
                table_insert(Bar.acResults,cmd)
                if #Bar.acResults>=5 then break end
            end
        end
    end

    local dropdownCount=Bar.showingPlayerSuggestions and #Bar.playerSuggestions or #Bar.acResults
    local acH=dropdownCount*36
    local bW,bH,gap=480,48,8
    local bX=math_floor(vw/2-bW/2)
    local bY=math_floor(vh-80)
    local els=Bar.elements
    local shadow=Drawing.new("Square")
    shadow.Visible=true shadow.Filled=true shadow.Color=Color3.fromRGB(0,0,0)
    shadow.Opacity=0.5 shadow.Rounding=12
    shadow.Position=Vector2.new(bX-4,bY-4) shadow.Size=Vector2.new(bW+8,bH+8)
    table_insert(els,shadow)
    local bar=Drawing.new("Square")
    bar.Visible=true bar.Filled=true bar.Color=Theme.Primary
    bar.Rounding=8 bar.Position=Vector2.new(bX,bY) bar.Size=Vector2.new(bW,bH)
    table_insert(els,bar)
    local borderBar=Drawing.new("Square")
    borderBar.Visible=true borderBar.Filled=false borderBar.Color=Theme.Accent
    borderBar.Rounding=8 borderBar.Thickness=2
    borderBar.Position=Vector2.new(bX,bY) borderBar.Size=Vector2.new(bW,bH)
    table_insert(els,borderBar)
    local promptChar=Settings.cuteMode and "♡" or ">"
    local prompt=Drawing.new("Text")
    prompt.Visible=true prompt.Text=promptChar
    prompt.Size=Settings.cuteMode and 16 or 18 prompt.Color=Theme.Accent prompt.Outline=true
    prompt.Position=Vector2.new(bX+14,bY+14)
    table_insert(els,prompt)
    local cur=(os_clock()%0.7)>0.35 and "|" or ""
    local inputT=Drawing.new("Text")
    inputT.Visible=true inputT.Text=tostring(Bar.input)..cur inputT.Size=15
    inputT.Color=Theme.TextPrimary inputT.Outline=true
    inputT.Position=Vector2.new(bX+36,bY+16)
    table_insert(els,inputT)
    if dropdownCount>0 then
        local dropY=bY-acH-gap-8
        local dropShadow=Drawing.new("Square")
        dropShadow.Visible=true dropShadow.Filled=true dropShadow.Color=Color3.fromRGB(0,0,0)
        dropShadow.Opacity=0.5 dropShadow.Rounding=8
        dropShadow.Position=Vector2.new(bX-4,dropY-4) dropShadow.Size=Vector2.new(bW+8,acH+16)
        table_insert(els,dropShadow)
        local dropBg=Drawing.new("Square")
        dropBg.Visible=true dropBg.Filled=true dropBg.Color=Theme.Secondary
        dropBg.Rounding=8 dropBg.Position=Vector2.new(bX,dropY) dropBg.Size=Vector2.new(bW,acH+8)
        table_insert(els,dropBg)
        if Bar.showingPlayerSuggestions then
            for i,suggestion in Bar.playerSuggestions do
                local yP=dropY+(i-1)*36+4
                local sel=(i==Bar.playerSuggestionSelected)
                if sel then
                    local hl=Drawing.new("Square")
                    hl.Visible=true hl.Filled=true hl.Color=Theme.Accent hl.Opacity=0.2
                    hl.Rounding=4 hl.Position=Vector2.new(bX+4,yP) hl.Size=Vector2.new(bW-8,32)
                    table_insert(els,hl)
                end
                local isSpecial=(suggestion.name=="random" or suggestion.name=="nearest" or suggestion.name=="farthest")
                local dotColor=isSpecial and Theme.Accent or Theme.Visual
                local dot=Drawing.new("Circle")
                dot.Visible=true dot.Filled=true dot.Color=dotColor
                dot.NumSides=12 dot.Position=Vector2.new(bX+18,yP+16) dot.Radius=4
                table_insert(els,dot)
                local displayTextSug=tostring(suggestion.displayName)
                if not isSpecial and suggestion.displayName~=suggestion.name then
                    displayTextSug=tostring(suggestion.displayName).." (@"..tostring(suggestion.name)..")"
                end
                local nameT=Drawing.new("Text")
                nameT.Visible=true nameT.Text=displayTextSug nameT.Size=13
                nameT.Color=sel and Theme.AccentLight or (isSpecial and Theme.Accent or Theme.TextPrimary) nameT.Outline=true
                nameT.Position=Vector2.new(bX+30,yP+8)
                table_insert(els,nameT)
            end
        else
            for i,cmd in Bar.acResults do
                local yP=dropY+(i-1)*36+4
                local sel=(i==Bar.acSelected)
                if sel then
                    local hl=Drawing.new("Square")
                    hl.Visible=true hl.Filled=true hl.Color=Theme.Accent hl.Opacity=0.2
                    hl.Rounding=4 hl.Position=Vector2.new(bX+4,yP) hl.Size=Vector2.new(bW-8,32)
                    table_insert(els,hl)
                end
                local dot=Drawing.new("Circle")
                dot.Visible=true dot.Filled=true dot.Color=catColor(cmd.cat)
                dot.NumSides=12 dot.Position=Vector2.new(bX+18,yP+16) dot.Radius=4
                table_insert(els,dot)
                local displayName=cmd.isAnimPack and (";animation "..tostring(cmd.packName)) or (";"..tostring(cmd.name))
                local cmdT=Drawing.new("Text")
                cmdT.Visible=true cmdT.Text=displayName cmdT.Size=13
                cmdT.Color=sel and Theme.AccentLight or Theme.Accent cmdT.Outline=true
                cmdT.Position=Vector2.new(bX+30,yP+8)
                table_insert(els,cmdT)
                local descT=Drawing.new("Text")
                descT.Visible=true descT.Text=" - "..tostring(cmd.desc) descT.Size=11
                descT.Color=Theme.TextMuted descT.Outline=true
                descT.Position=Vector2.new(bX+30+(#displayName)*8+5,yP+9)
                table_insert(els,descT)
            end
        end
    end
    Bar.needsRedraw=false
end

