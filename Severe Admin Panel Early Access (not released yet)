Helpers.buildOptionsKeybindsTab = function(els,px,py,contentStartY,contentEndY)
    local searchX=px+Options.PAD
    local searchY=contentStartY
    local searchW=Options.W-Options.PAD*2
    local searchH=36
    local searchBg=Drawing.new("Square")
    searchBg.Visible=true searchBg.Filled=true searchBg.Color=Theme.Tertiary
    searchBg.Rounding=6 searchBg.Position=Vector2.new(searchX,searchY) searchBg.Size=Vector2.new(searchW,searchH)
    table_insert(els,searchBg)
    local searchBorder=Drawing.new("Square")
    searchBorder.Visible=true searchBorder.Filled=false
    searchBorder.Color=Options.searchFocused and Theme.Accent or Theme.Border
    searchBorder.Rounding=6 searchBorder.Thickness=Options.searchFocused and 2 or 1
    searchBorder.Position=Vector2.new(searchX,searchY) searchBorder.Size=Vector2.new(searchW,searchH)
    table_insert(els,searchBorder)
    Options.searchBounds={pos=Vector2.new(searchX,searchY),size=Vector2.new(searchW,searchH)}
    local searchIcon=Drawing.new("Text")
    searchIcon.Visible=true searchIcon.Text=Settings.cuteMode and "♡" or ">"
    searchIcon.Size=14 searchIcon.Color=Options.searchFocused and Theme.Accent or Theme.TextMuted
    searchIcon.Outline=true searchIcon.Position=Vector2.new(searchX+10,searchY+10)
    table_insert(els,searchIcon)
    local searchDisplayText=Options.searchQuery=="" and "Search keybinds..." or tostring(Options.searchQuery)
    if Options.searchFocused then
        local cursor=(os_clock()%0.7)>0.35 and "|" or ""
        searchDisplayText=tostring(Options.searchQuery)..cursor
    end
    local searchText=Drawing.new("Text")
    searchText.Visible=true searchText.Text=searchDisplayText searchText.Size=13
    searchText.Color=(Options.searchQuery=="" and not Options.searchFocused) and Theme.TextMuted or Theme.TextPrimary
    searchText.Outline=true searchText.Position=Vector2.new(searchX+26,searchY+11)
    table_insert(els,searchText)
    local itemsStartY=searchY+searchH+10
    local items=Helpers.getOptionsFiltered()
    local maxScroll=Helpers.optionsMaxScroll()
    Options.scrollOffset=math_clamp(Options.scrollOffset,0,maxScroll)
    local startIdx=math_floor(Options.scrollOffset)+1
    local endIdx=math.min(startIdx+Options.VISIBLE-1,#items)
