Helpers.applyAnimationPack = function(packName)
    local pack=AnimationPacks[packName]
    if not pack then
        for k,v in pairs(AnimationPacks) do
            if string_lower(k)==string_lower(tostring(packName)) then pack=v packName=k break end
        end
    end
    if not pack then
        notify("Unknown pack. Available: "..table.concat(AnimationPackOrder,", "))
        return
    end
    pcall(function()
        local char=LocalPlayer.Character
        if not char then notify("No character") return end
        local animate=char:FindFirstChild("Animate")
        if not animate then notify("No Animate script found") return end
        local function writeAnimId(animObj,url)
            if not animObj then return end
            pcall(function()
                local offset=0xD0
                local pointer=memory.readu64(animObj,offset)
                local buf=buffer.create(#url+1)
                buffer.writestring(buf,0,url)
                memory.writebuffer(pointer,buf)
            end)
            pcall(function() animObj.AnimationId=url end)
        end
        if animate:FindFirstChild("idle") then
            local idle=animate.idle
            writeAnimId(idle:FindFirstChild("Animation1"),pack.idle1)
            writeAnimId(idle:FindFirstChild("Animation2"),pack.idle2 or pack.idle1)
        end
        if animate:FindFirstChild("walk") then writeAnimId(animate.walk:FindFirstChild("WalkAnim"),pack.walk) end
        if animate:FindFirstChild("run") then writeAnimId(animate.run:FindFirstChild("RunAnim"),pack.run) end
        if animate:FindFirstChild("jump") then writeAnimId(animate.jump:FindFirstChild("JumpAnim"),pack.jump) end
        if animate:FindFirstChild("fall") then writeAnimId(animate.fall:FindFirstChild("FallAnim"),pack.fall) end
        if animate:FindFirstChild("climb") then writeAnimId(animate.climb:FindFirstChild("ClimbAnim"),pack.climb) end
        notify("Animation: "..packName)
    end)
end

