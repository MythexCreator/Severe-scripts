    CommandPanelDrawing.scrollOffset=math_clamp(CommandPanelDrawing.scrollOffset,0,maxScroll)
    local startIdx=math_floor(CommandPanelDrawing.scrollOffset)+1
    local endIdx=math.min(startIdx+CommandPanelDrawing.maxVisible-1,#filtered)
    CommandPanelDrawing.itemBounds={}
    if #filtered==0 then
        local noResults=Drawing.new("Text")
        noResults.Visible=true
        noResults.Text=Settings.cuteMode and "No commands found ◕‿◕" or "No commands found"
        noResults.Size=14 noResults.Color=Theme.TextMuted noResults.Outline=true
        noResults.Center=true noResults.Position=Vector2.new(contentX+contentW/2,contentY+50)
        table_insert(els,noResults)
    else
        for i=startIdx,endIdx do
            local cmd=filtered[i]
            local localIdx=i-startIdx
            local itemY=contentY+localIdx*(ITEM_H+6)
            local itemBg=Drawing.new("Square")
            itemBg.Visible=true itemBg.Filled=true itemBg.Color=Theme.Card
            itemBg.Rounding=6 itemBg.Position=Vector2.new(contentX,itemY) itemBg.Size=Vector2.new(contentW,ITEM_H)
            table_insert(els,itemBg)
            table_insert(CommandPanelDrawing.itemBounds,{
                pos=Vector2.new(contentX,itemY),
                size=Vector2.new(contentW,ITEM_H),
                cmd=cmd
            })
            local tagW=70
            local tagBg=Drawing.new("Square")
            tagBg.Visible=true tagBg.Filled=true tagBg.Color=catColor(cmd.cat)
            tagBg.Rounding=4 tagBg.Position=Vector2.new(contentX+10,itemY+8) tagBg.Size=Vector2.new(tagW,18)
            table_insert(els,tagBg)
            local tagText=Drawing.new("Text")
