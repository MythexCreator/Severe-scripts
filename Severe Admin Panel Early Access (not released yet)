            or workspace:FindFirstChildOfClass("SpawnLocation")
        if spawns then cachedSpawnLocation=spawns.Position+Vector3.new(0,3,0) return end
        for _,obj in workspace:GetDescendants() do
            if obj:IsA("SpawnLocation") then
                cachedSpawnLocation=obj.Position+Vector3.new(0,3,0) return
            end
        end
        cachedSpawnLocation=Vector3.new(0,50,0)
    end)
end

local function getSpawnLocation()
