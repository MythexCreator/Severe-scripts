Helpers.updateCoordsDisplay = function()
    if not CoordsDisplay.open then return end
    if #CoordsDisplay.elements<14 then Helpers.createCoordsDisplay() return end
    pcall(function()
        local char=LocalPlayer.Character
        local x,y,z=0,0,0
        if char then
            local root=char:FindFirstChild("HumanoidRootPart")
            if root then x=root.Position.X y=root.Position.Y z=root.Position.Z end
        end
        CoordsDisplay.elements[10].Text=string.format("%.2f",x)
        CoordsDisplay.elements[12].Text=string.format("%.2f",y)
        CoordsDisplay.elements[14].Text=string.format("%.2f",z)
    end)
end

