Helpers.createCoordsDisplay = function()
    clearCoordsDisplay()
    local cam=workspace.CurrentCamera
    if not cam then return end
    if CoordsDisplay.posX==nil then
        CoordsDisplay.posX=math_floor(cam.ViewportSize.X/2-CoordsDisplay.W/2)
        CoordsDisplay.posY=math_floor(cam.ViewportSize.Y/2-CoordsDisplay.H/2)
    end
    CoordsDisplay.posX=math_clamp(CoordsDisplay.posX,0,cam.ViewportSize.X-CoordsDisplay.W)
    CoordsDisplay.posY=math_clamp(CoordsDisplay.posY,0,cam.ViewportSize.Y-CoordsDisplay.H)
    local px,py=CoordsDisplay.posX,CoordsDisplay.posY
    local els=CoordsDisplay.elements
    local shadow=Drawing.new("Square")
    shadow.Visible=true shadow.Filled=true shadow.Color=Color3.fromRGB(0,0,0)
    shadow.Opacity=0.5 shadow.Rounding=10
    shadow.Position=Vector2.new(px-3,py-3) shadow.Size=Vector2.new(CoordsDisplay.W+6,CoordsDisplay.H+6)
    table_insert(els,shadow)
    local bg=Drawing.new("Square")
    bg.Visible=true bg.Filled=true bg.Color=Theme.Primary
    bg.Rounding=8 bg.Position=Vector2.new(px,py) bg.Size=Vector2.new(CoordsDisplay.W,CoordsDisplay.H)
    table_insert(els,bg)
    local border=Drawing.new("Square")
    border.Visible=true border.Filled=false border.Color=Theme.Border
