    else
        for i=startIdx,endIdx do
            local cmd=items[i]
            local localIdx=i-startIdx
            local itemY=itemsStartY+localIdx*(Options.ITEM_H+4)
            local itemH=Options.ITEM_H-4
            local itemBg=Drawing.new("Square")
            itemBg.Visible=true itemBg.Filled=true itemBg.Color=Theme.Card
            itemBg.Rounding=6 itemBg.Position=Vector2.new(px+Options.PAD,itemY) itemBg.Size=Vector2.new(contentAreaW,itemH)
            table_insert(els,itemBg)
            local dot=Drawing.new("Circle")
            dot.Visible=true dot.Filled=true dot.Color=catColor(cmd.cat)
            dot.NumSides=12 dot.Position=Vector2.new(px+Options.PAD+18,itemY+itemH/2) dot.Radius=5
            table_insert(els,dot)
            local cmdNameText=Drawing.new("Text")
            cmdNameText.Visible=true cmdNameText.Text=tostring(cmd.name) cmdNameText.Size=12
            cmdNameText.Color=Theme.TextPrimary cmdNameText.Outline=true
            cmdNameText.Position=Vector2.new(px+Options.PAD+35,itemY+8)
            table_insert(els,cmdNameText)
            local descText=Drawing.new("Text")
            descText.Visible=true descText.Text=tostring(cmd.desc) descText.Size=9
            descText.Color=Theme.TextSecondary descText.Outline=true
            descText.Position=Vector2.new(px+Options.PAD+35,itemY+24)
            table_insert(els,descText)
            local currentKey,_=getKeybindForCommand(cmd.name)
            local currentMode=getModeForCommand(cmd.name)
            local keyText=currentKey and formatKeyName(currentKey) or "NONE"
            local isWaiting=(Keybinds.settingFor==cmd.name)
            if isWaiting then keyText="..." end
            local needsValue=valueCommands[cmd.name]~=nil
            local valueBoxW=needsValue and 50 or 0
            local valueBoxGap=needsValue and 6 or 0
            local modeBtnW,keyBtnW,btnGap=50,60,6
            local keyBtnX=px+Options.PAD+contentAreaW-keyBtnW-8
            local modeBtnX=keyBtnX-modeBtnW-btnGap
            local valueBoxX=modeBtnX-valueBoxW-valueBoxGap
            local btnY=itemY+itemH/2-11
            if needsValue then
                local isEditing=(Options.editingValueFor==cmd.name)
                local currentValue=getKeybindValue(cmd.name) or tostring(valueCommands[cmd.name].default)
                local displayValue=tostring(currentValue)
                if isEditing then
                    displayValue=tostring(Options.editingValueText)
                    local cursor=(os_clock()%0.7)>0.35 and "|" or ""
                    displayValue=displayValue..cursor
                end
                local valueBg=Drawing.new("Square")
                valueBg.Visible=true valueBg.Filled=true
                valueBg.Color=isEditing and Theme.Accent or Theme.Tertiary
                valueBg.Rounding=4 valueBg.Position=Vector2.new(valueBoxX,btnY) valueBg.Size=Vector2.new(valueBoxW,22)
                table_insert(els,valueBg)
                local valueLabel=Drawing.new("Text")
