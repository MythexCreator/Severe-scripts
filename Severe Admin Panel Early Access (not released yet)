    footerLine.Visible=true footerLine.Filled=true footerLine.Color=Theme.Border
    footerLine.Position=Vector2.new(px+PAD,footerY) footerLine.Size=Vector2.new(W-PAD*2,1)
    table_insert(els,footerLine)
    local cmdCount=Drawing.new("Text")
    cmdCount.Visible=true cmdCount.Text=tostring(#filtered).." commands" cmdCount.Size=10
    cmdCount.Color=Theme.TextMuted cmdCount.Outline=true
    cmdCount.Position=Vector2.new(px+PAD+5,footerY+12)
    table_insert(els,cmdCount)
    local hint=Drawing.new("Text")
    hint.Visible=true hint.Text="Drag corner to resize" hint.Size=10
    hint.Color=Theme.TextMuted hint.Outline=true
    hint.Position=Vector2.new(px+W-130,footerY+12)
    table_insert(els,hint)
    CommandPanelDrawing.needsRedraw=false
end

showCommandPanel = function()
    if CommandPanel.open then return end
    CommandPanel.open=true
    CommandPanel.selectedCategory="ALL"
    CommandPanel.searchQuery=""
    CommandPanel.searchFocused=false
    CommandPanelDrawing.scrollOffset=0
    CommandPanelDrawing.targetScroll=0
    CommandPanelDrawing.scrollDragging=false
    CommandPanelDrawing.needsRedraw=true
    Helpers.createCommandPanelDrawing()
end

hideCommandPanel = function()
    if not CommandPanel.open then return end
    CommandPanel.open=false
    CommandPanel.searchFocused=false
    CommandPanelDrawing.scrollDragging=false
    clearCommandPanelDrawing()
    saveSettings()
end

toggleCommandPanel = function()
    if CommandPanel.open then hideCommandPanel() else showCommandPanel() end
end

