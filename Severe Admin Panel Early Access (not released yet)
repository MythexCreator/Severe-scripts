local function findPlayer(name)
    if not name or name=="" then return nil end
    local n=string_lower(name)
    for _,p in Players:GetChildren() do
        if string_lower(p.Name)==n or string_lower(p.DisplayName)==n then return p end
        if string_find(string_lower(p.Name),n,1,true)==1
            or string_find(string_lower(p.DisplayName),n,1,true)==1 then
            return p
        end
    end
    return nil
end

local function vec3dist(a,b)
    local dx=a.X-b.X
    local dy=a.Y-b.Y
    local dz=a.Z-b.Z
    return math_sqrt(dx*dx+dy*dy+dz*dz)
end

local function getRandomPlayer()
    local others={}
    for _,p in Players:GetChildren() do
        if p~=LocalPlayer and p.Character then table_insert(others,p) end
    end
    if #others==0 then return nil end
    return others[math.random(1,#others)]
end

local function getNearestPlayer()
    local char=LocalPlayer.Character
    if not char then return nil end
    local root=char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local myPos=root.Position
    local nearest,nearestDist=nil,math_huge
    for _,p in Players:GetChildren() do
        if p~=LocalPlayer and p.Character then
            local tRoot=p.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist=vec3dist(tRoot.Position,myPos)
                if dist<nearestDist then nearest=p nearestDist=dist end
            end
        end
    end
    return nearest
end

local function getFarthestPlayer()
    local char=LocalPlayer.Character
    if not char then return nil end
    local root=char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local myPos=root.Position
    local farthest,farthestDist=nil,-1
    for _,p in Players:GetChildren() do
        if p~=LocalPlayer and p.Character then
            local tRoot=p.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist=vec3dist(tRoot.Position,myPos)
                if dist>farthestDist then farthest=p farthestDist=dist end
            end
        end
    end
    return farthest
end

