-------------------------------------------------
-- Role tagi
-------------------------------------------------
local RoleTags = {
    Knife = { "Murderer", C.Murderer },
    Gun   = { "Sheriff",  C.Sheriff },
}

-------------------------------------------------
-- Menu
-------------------------------------------------
local Menu = {
    Open   = false,
    X      = 60,
    Y      = 80,
    W      = 250,
    Drag   = false,
    DragOX = 0,
    DragOY = 0,
    WasLMB = false,
    WasKey = false,
}

local HEADER_H = 38
local ITEM_H   = 23
local SEP_H    = 11
local INFO_H   = 22

local Items = {
    { t = "sep" },
    { t = "section", label = "ESP" },
    { t = "toggle",  label = "Boxes",         key = "ESP_Boxes" },
    { t = "toggle",  label = "Names",          key = "ESP_Names" },
    { t = "toggle",  label = "Roles",          key = "ESP_Roles" },
    { t = "toggle",  label = "Tracers",        key = "ESP_Tracers" },
    { t = "toggle",  label = "Distance",       key = "ESP_Distance" },
    { t = "sep" },
    { t = "section", label = "OTHER" },
    { t = "toggle",  label = "Gun ESP",        key = "GunESP" },
    { t = "toggle",  label = "Auto Pick Gun",  key = "AutoPickGun" },
    { t = "toggle",  label = "Murderer Alert", key = "MurdAlert" },
    { t = "sep" },
    { t = "info",    label = "RIGHT SHIFT - Toggle Menu" },
}

local function calcH()
    local h = HEADER_H + 14
    for i = 1, #Items do
        local it = Items[i]
        if     it.t == "sep"     then h += SEP_H
        elseif it.t == "section" then h += ITEM_H
        elseif it.t == "toggle"  then h += ITEM_H
        elseif it.t == "info"    then h += INFO_H
        end
    end
    return h
end

-------------------------------------------------
-- Cached Data
-------------------------------------------------
local Cache = {
    Map = nil,
    Gun = nil,
}
local Roles       = {}
local AlertActive = false

-------------------------------------------------
-- Utility
-------------------------------------------------
local function getChar(player)
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChild("Humanoid")
    if not root or not hum then return nil end
    if hum.Health <= 0 then return nil end
    return char, root, hum
end

local function dist3(a, b)
    local dx = a.X - b.X
    local dy = a.Y - b.Y
    local dz = a.Z - b.Z
    return math.sqrt(dx*dx + dy*dy + dz*dz)
end

local function w2s(pos)
    local v, onScreen = CurrentCamera:WorldToScreenPoint(pos)
    return Vector2.new(v.X, v.Y), onScreen
end

local function inR(mx, my, rx, ry, rw, rh)
    return mx >= rx and mx <= rx+rw and my >= ry and my <= ry+rh
end

local function getMouseXY()
    local x, y = 0, 0
    pcall(function()
        local loc = game:GetService("UserInputService"):GetMouseLocation()
        x = loc.X
        y = loc.Y
    end)
    return x, y
end

-------------------------------------------------
-- Get Current Map
-------------------------------------------------
local function GetMap()
    local found = nil
    pcall(function()
        local kids = workspace:GetChildren()
        for i = 1, #kids do
            local m = kids[i]
            if m.ClassName == "Model" and m:HasTag("CurrentMap") then
                found = m
                break
            end
        end
    end)
    return found
end

-------------------------------------------------
-- Get GunDrop
-------------------------------------------------
local function GetGunDrop()
    local map = Cache.Map
    if not map then return nil end

    local found = nil
    pcall(function()
        local kids = map:GetChildren()
        for i = 1, #kids do
            local obj = kids[i]
            if obj.ClassName == "Part" and obj.Name == "GunDrop" then
                found = obj
                break
            end
        end
    end)
    return found
end

-------------------------------------------------
-- Check Role
-------------------------------------------------
local function CheckRole(player)
    local char = player.Character
    if not char then return nil, nil end

    local bp = nil
    pcall(function() bp = player.Backpack end)

    local foundRole, foundColor = nil, nil

    pcall(function()
        local kids = char:GetChildren()
        for i = 1, #kids do
            local tool = kids[i]
            local data = RoleTags[tool.Name]
            if data then
                foundRole, foundColor = data[1], data[2]
                break
            end
        end
    end)

    if foundRole then return foundRole, foundColor end

    if bp then
        pcall(function()
            local kids = bp:GetChildren()
            for i = 1, #kids do
                local tool = kids[i]
                local data = RoleTags[tool.Name]
                if data then
                    foundRole, foundColor = data[1], data[2]
                    break
                end
            end
        end)
    end

    return foundRole, foundColor
end

-------------------------------------------------
-- Update Loop
-------------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.5)

        local newMap = GetMap()
        if newMap ~= Cache.Map then
            Cache.Map = newMap
        end

        local newGun = GetGunDrop()
        if newGun ~= Cache.Gun then
            Cache.Gun = newGun
        end

        local nr = {}
        pcall(function()
            local pList = Players:GetChildren()
            for i = 1, #pList do
                local plr = pList[i]
                if plr == LocalPlayer then continue end
                if not plr:IsA("Player") then continue end

                local role, color = CheckRole(plr)
                if role then
                    nr[plr] = { role, color }
                else
                    nr[plr] = { "Innocent", C.Innocent }
                end
            end
        end)
        Roles = nr
    end
end)

-------------------------------------------------
-- Auto Pick Gun
-------------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.2)
        if F.AutoPickGun and Cache.Gun then
            pcall(function()
                local _, root = getChar(LocalPlayer)
                if root then
                    local d = dist3(root.Position, Cache.Gun.Position)
                    if d < 500 then
                        local old = root.CFrame
                        root.CFrame = CFrame.new(Cache.Gun.Position)
                        task.wait(0.06)
                        root.CFrame = old
                    end
                end
            end)
        end
    end
end)

-------------------------------------------------
-- Murderer Alert
-------------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.3)

        if not F.MurdAlert then
            AlertActive = false
            continue
        end

        local murd = nil
        for plr, data in Roles do
            if data[1] == "Murderer" then murd = plr break end
        end

        if not murd then
            AlertActive = false
            continue
        end

        local _, mr = getChar(murd)
        local _, lr = getChar(LocalPlayer)
        if mr and lr and dist3(mr.Position, lr.Position) < F.AlertDist then
            AlertActive = true
        else
            AlertActive = false
        end
    end
end)

-------------------------------------------------
-- Render Menu (RIGHT SHIFT toggle)
-------------------------------------------------
local function renderMenu()
    -- Sprawdź prawy shift
    local keyNow = false
    local keys = getpressedkeys()
    for i = 1, #keys do
        local k = keys[i]
        -- Severe może zwracać różnie nazwę — sprawdzamy kilka wariantów
        if k == "RightShift" or k == "Right Shift" or k == "RShift" then
            keyNow = true
            break
        end
    end

    if keyNow and not Menu.WasKey then
        Menu.Open = not Menu.Open
    end
    Menu.WasKey = keyNow

    if not Menu.Open then
        Menu.WasLMB = isleftpressed()
        return
    end

    local mmx, mmy = getMouseXY()
    local lmbNow   = isleftpressed()
    local lmbClick = lmbNow and not Menu.WasLMB

    if lmbClick and not Menu.Drag and inR(mmx, mmy, Menu.X, Menu.Y, Menu.W, HEADER_H) then
        Menu.Drag   = true
        Menu.DragOX = mmx - Menu.X
        Menu.DragOY = mmy - Menu.Y
    end

    if Menu.Drag then
        if lmbNow then
            Menu.X = mmx - Menu.DragOX
            Menu.Y = mmy - Menu.DragOY
        else
            Menu.Drag = false
        end
    end

    local x, y = Menu.X, Menu.Y
    local w    = Menu.W
    local h    = calcH()

    DrawingImmediate.FilledRectangle(Vector2.new(x+4,y+4), Vector2.new(w,h), C.Shadow, 0.3)
    DrawingImmediate.FilledRectangle(Vector2.new(x,y), Vector2.new(w,h), C.BG, 1)
    DrawingImmediate.FilledRectangle(Vector2.new(x,y), Vector2.new(3,h), C.Border, 1)
    DrawingImmediate.Rectangle(Vector2.new(x,y), Vector2.new(w,h), Color3.fromRGB(28,28,28), 1, 1)
    DrawingImmediate.FilledRectangle(Vector2.new(x+3,y), Vector2.new(w-3,HEADER_H), C.BGLight, 1)
    DrawingImmediate.OutlinedText(Vector2.new(x+w/2,y+13), 14, Color3.fromRGB(160,0,0), 0.4, "MURDER MYSTERY 2", true, "Tamzen")
    DrawingImmediate.OutlinedText(Vector2.new(x+w/2,y+13), 14, Color3.new(1,1,1), 1, "MURDER MYSTERY 2", true, "Tamzen")
    DrawingImmediate.FilledRectangle(Vector2.new(x+3,y+HEADER_H-2), Vector2.new(w-3,2), C.Border, 1)

    local iy = y + HEADER_H + 6

    for idx = 1, #Items do
        local item = Items[idx]

        if item.t == "sep" then
            DrawingImmediate.FilledRectangle(
                Vector2.new(x+12, iy+math.floor(SEP_H/2)),
                Vector2.new(w-24,1), C.Separator, 1
            )
            iy += SEP_H

        elseif item.t == "section" then
            DrawingImmediate.OutlinedText(
                Vector2.new(x+14,iy+5), 10,
                C.Section, 1, item.label, false, "Tamzen"
            )
            iy += ITEM_H

        elseif item.t == "toggle" then
            local val     = F[item.key]
            local hovered = (not Menu.Drag) and inR(mmx,mmy,x+3,iy,w-3,ITEM_H)

            if hovered then
                DrawingImmediate.FilledRectangle(
                    Vector2.new(x+3,iy), Vector2.new(w-3,ITEM_H),
                    Color3.fromRGB(19,19,19), 1
                )
            end

            DrawingImmediate.OutlinedText(
                Vector2.new(x+16,iy+5), 12,
                hovered and Color3.new(1,1,1) or C.Text,
                1, item.label, false, "Tamzen"
            )

            local tx  = x + w - 52
            local ty2 = iy + 5
            local tw  = 38
            local th  = 13

            DrawingImmediate.FilledRectangle(
                Vector2.new(tx,ty2), Vector2.new(tw,th),
                val and C.ToggleOn or C.ToggleOff, 1
            )
            DrawingImmediate.Rectangle(
                Vector2.new(tx,ty2), Vector2.new(tw,th),
                val and C.ToggleBOn or C.ToggleBOf, 1, 1
            )
            DrawingImmediate.FilledCircle(
                Vector2.new(val and (tx+tw-7) or (tx+7), ty2+th/2),
                5, val and Color3.new(1,1,1) or Color3.fromRGB(120,120,120), 1
            )

            if lmbClick and not Menu.Drag and inR(mmx,mmy,tx,ty2,tw,th) then
                F[item.key] = not F[item.key]
            end

            iy += ITEM_H

        elseif item.t == "info" then
            DrawingImmediate.OutlinedText(
                Vector2.new(x+w/2,iy+6), 10,
                C.TextDim, 0.9, item.label, true, "Tamzen"
            )
            iy += INFO_H
        end
    end

    Menu.WasLMB = lmbNow
end

-------------------------------------------------
-- Render Murderer Alert
-------------------------------------------------
local function renderAlert()
    if not AlertActive then return end

    local vpX = CurrentCamera.ViewportSize.X
    local vpY = CurrentCamera.ViewportSize.Y

    local pulse = (math.sin(tick() * 6) + 1) / 2
    local opacity = 0.7 + pulse * 0.3

    local barW = 320
    local barH = 45
    local bx = vpX/2 - barW/2
    local by = vpY * 0.12

    DrawingImmediate.FilledRectangle(
        Vector2.new(bx+4, by+4), Vector2.new(barW, barH),
        Color3.new(0,0,0), 0.4
    )
    DrawingImmediate.FilledRectangle(
        Vector2.new(bx, by), Vector2.new(barW, barH),
        Color3.fromRGB(20, 0, 0), 0.85
    )
    DrawingImmediate.Rectangle(
        Vector2.new(bx, by), Vector2.new(barW, barH),
        C.Alert, opacity, 2
    )
    DrawingImmediate.OutlinedText(
        Vector2.new(vpX/2, by + 8), 16,
        C.Alert, 1,
        "WARNING", true, "Tamzen"
    )
    DrawingImmediate.OutlinedText(
        Vector2.new(vpX/2, by + 26), 12,
        Color3.new(1,1,1), 1,
        "Murderer is nearby!", true, "Tamzen"
    )
end

-------------------------------------------------
-- Render ESP
-------------------------------------------------
local function renderESP()
    local _, myRoot = getChar(LocalPlayer)
    if not myRoot then return end

    local anyESP = F.ESP_Boxes or F.ESP_Names or F.ESP_Roles or F.ESP_Tracers or F.ESP_Distance
    if not anyESP and not F.GunESP then return end

    local rvx = CurrentCamera.RightVector.X
    local rvz = CurrentCamera.RightVector.Z
    local vpX = CurrentCamera.ViewportSize.X
    local vpY = CurrentCamera.ViewportSize.Y

    if anyESP then
        for plr, data in Roles do
            local roleName  = data[1]
            local roleColor = data[2]

            local char, root, hum = getChar(plr)
            if not char or not root or not hum then continue end

            local d = dist3(myRoot.Position, root.Position)
            if d > F.ESP_MaxDist then continue end

            local head = char:FindFirstChild("Head")
            if not head then continue end

            local rootPos = root.Position
            local headPos = head.Position

            local topScreen, topVis = w2s(Vector3.new(headPos.X, headPos.Y + 1.5, headPos.Z))
            local botScreen, botVis = w2s(Vector3.new(rootPos.X, rootPos.Y - 3.3, rootPos.Z))

            if not topVis or not botVis then continue end

            local boxH = botScreen.Y - topScreen.Y
            if boxH < 8 then continue end

            local hw = 2.5
            local lEdge = w2s(Vector3.new(rootPos.X - rvx*hw, rootPos.Y, rootPos.Z - rvz*hw))
            local rEdge = w2s(Vector3.new(rootPos.X + rvx*hw, rootPos.Y, rootPos.Z + rvz*hw))
            local boxW  = math.abs(rEdge.X - lEdge.X)

            if boxW < 6 then boxW = boxH * 0.5 end

            local centerX = (lEdge.X + rEdge.X) / 2

            if F.ESP_Boxes then
                local bx = centerX - boxW/2
                local by = topScreen.Y
                DrawingImmediate.Rectangle(
                    Vector2.new(bx-1, by-1),
                    Vector2.new(boxW+2, boxH+2),
                    Color3.new(0,0,0), 0.5, 1
                )
                DrawingImmediate.Rectangle(
                    Vector2.new(bx, by),
                    Vector2.new(boxW, boxH),
                    roleColor, 0.9, 1.5
                )
            end

            local ty = topScreen.Y - 18
            if F.ESP_Names then
                DrawingImmediate.OutlinedText(
                    Vector2.new(centerX, ty), 13,
                    Color3.new(1,1,1), 1,
                    plr.DisplayName, true, "Tamzen"
                )
                ty -= 15
            end

            if F.ESP_Roles then
                DrawingImmediate.OutlinedText(
                    Vector2.new(centerX, ty), 12,
                    roleColor, 1,
                    "[" .. roleName .. "]", true, "Tamzen"
                )
            end

            if F.ESP_Distance then
                DrawingImmediate.OutlinedText(
                    Vector2.new(centerX, botScreen.Y + 4), 11,
                    Color3.fromRGB(160,160,160), 0.8,
                    math.floor(d) .. "st", true, "Tamzen"
                )
            end

            if F.ESP_Tracers then
                DrawingImmediate.Line(
                    Vector2.new(vpX/2, vpY),
                    Vector2.new(centerX, botScreen.Y),
                    roleColor, 0.55, 1, 1.5
                )
            end
        end
    end

    if F.GunESP and Cache.Gun then
        pcall(function()
            local gp, gv = w2s(Cache.Gun.Position)
            if gv then
                local gd = dist3(myRoot.Position, Cache.Gun.Position)
                DrawingImmediate.OutlinedText(
                    gp + Vector2.new(0,-20), 14,
                    C.Gun, 1,
                    "GUN [" .. math.floor(gd) .. "st]",
                    true, "Tamzen"
                )
                DrawingImmediate.FilledCircle(gp, 6, C.Gun, 0.9)
                DrawingImmediate.Circle(gp, 9, C.Gun, 0.6, 1.5)
            end
        end)
    end
end

-------------------------------------------------
-- Main Loop
-------------------------------------------------
RunService.Render:Connect(function()
    CurrentCamera = workspace.CurrentCamera
    renderESP()
    renderAlert()
    renderMenu()
end)
