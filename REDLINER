local Cursor = Vector2.new(0, 0)

local function Toggle(label, key)
    local rowPos     = Vector2.new(UI.Position.X + UI.Padding, Cursor.Y)
    local rowSize    = Vector2.new(UI.Size.X - UI.Padding * 2, 18)
    local toggleSize = Vector2.new(36, 16)
    local togglePos  = Vector2.new(UI.Position.X + UI.Size.X - UI.Padding - toggleSize.X, Cursor.Y)

    drawText(Vector2.new(rowPos.X, rowPos.Y), 14, UI.Colors.Text, label, false, 1)
    local enabled = Config[key]
    drawRect(togglePos, toggleSize, enabled and UI.Colors.ToggleOn or UI.Colors.ToggleOff, 1)
    drawOutline(togglePos, toggleSize, UI.Colors.Border, 1, 1)

    local knobSize = Vector2.new(12, 12)
    local knobPos  = enabled
        and Vector2.new(togglePos.X + toggleSize.X - knobSize.X - 2, togglePos.Y + 2)
        or  Vector2.new(togglePos.X + 2, togglePos.Y + 2)
    drawRect(knobPos, knobSize, UI.Colors.Text, 1)

    if Input.LeftPressedNow and not ClickConsumed then
        if pointInRect(Input.Mouse, rowPos, rowSize) then
            Config[key]   = not Config[key]
            ClickConsumed = true
            Debug.lastChangedKey = key
            Debug.lastChangedVal = tostring(Config[key])
            saveConfig()
        end
    end
    Cursor = Vector2.new(Cursor.X, Cursor.Y + 26)
end

local function Slider(label, key, min, max, step, decimals)
    step     = step     or 1
    decimals = decimals or 0

    local rowPos = Vector2.new(UI.Position.X + UI.Padding, Cursor.Y)
    local barSize = Vector2.new(180, 6)
    local barPos  = Vector2.new(UI.Position.X + UI.Size.X - UI.Padding - barSize.X, Cursor.Y + 6)

    drawText(rowPos, 14, UI.Colors.Text, label, false, 1)
    local valStr = string.format("%." .. decimals .. "f", Config[key])
    drawText(Vector2.new(barPos.X - 55, rowPos.Y), 14, UI.Colors.TextDim, valStr, false, 1)
    drawRect(barPos, barSize, UI.Colors.SliderTrack, 1)
    local alpha = math_clamp((Config[key] - min) / (max - min), 0, 1)
    drawRect(barPos, Vector2.new(barSize.X * alpha, barSize.Y), UI.Colors.SliderFill, 1)

    local hitPos  = Vector2.new(barPos.X, barPos.Y - 8)
    local hitSize = Vector2.new(barSize.X, 22)

    if Input.LeftDown and not Dragging then
        if pointInRect(Input.Mouse, hitPos, hitSize) then
            local pct = math_clamp((Input.Mouse.X - barPos.X) / barSize.X, 0, 1)
            local rawVal = min + (max - min) * pct
            local newVal = snapToStep(rawVal, step, min, max)

            if newVal ~= Config[key] then
                Config[key] = newVal
                Debug.lastChangedKey = key
                Debug.lastChangedVal = string.format("%." .. decimals .. "f", newVal)
                activeSlider = key
                sliderDirty  = true
            end
            ClickConsumed = true
        end
    end
    Cursor = Vector2.new(Cursor.X, Cursor.Y + 26)
end

local function Section(title)
