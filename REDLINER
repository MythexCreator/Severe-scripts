-- PARRY
------------------------------------------------------------
local parryActive    = false
local lastParryTime  = 0
local validatedParry = 0
local seenIndicators = {}

local function getGlareDelay(indicatorName)
    local key = PARRY_TRIGGERS[indicatorName]
    if not key then return 0 end
    return Config[key] or 0
end

local function tryParry(indicator, iaddress)
    if parryActive then return end
    local now = os.clock() * 1000
    if (now - lastParryTime) < Config.ParryCooldown then return end
    local glareDelay = getGlareDelay(indicator.Name)
    parryActive = true

    task_spawn(function()
        local totalDelay = Config.ParryLatency + glareDelay
        if totalDelay > 0 then task_wait(totalDelay / 1000) end
        keypress(Config.ParryKey)
        task_wait(0.03)
        keyrelease(Config.ParryKey)
        local a1 = os.clock()
        parryActive   = false
        lastParryTime = os.clock() * 1000
        local start = os.clock()
        while true do
            task_wait(0.01)
            if os.clock() - validatedParry < 0.2 then break end
            if os.clock() - start > 0.5 then break end
        end
        seenIndicators[iaddress] = nil
    end)
end

local function getAddress(obj)
    local ok, addr = pcall(function() return tostring(obj) end)
    return ok and addr or (obj.Name .. "_" .. tostring(math.random(1, 99999)))
end

local function processParryTriggers()
    if not Config.AutoParry then
        table_clear(seenIndicators)
        parryActive = false
        return
    end
    if not isrbxactive() then return end
    refreshReferences()

    if VisualEffects then
        for _, child in ipairs(VisualEffects:GetChildren()) do
            if PARRY_TRIGGERS[child.Name] then
                local addr = getAddress(child)
                if not seenIndicators[addr] then
                    seenIndicators[addr] = os.clock()
                    tryParry(child, addr)
                end
            end
        end
    end

    if WorkspEffects then
        local char = LocalPlayer and LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local rootPos = root.Position
                for _, child in ipairs(WorkspEffects:GetChildren()) do
                    if child.Name == "defaultParry" then
                        local part = nil
                        for _, v in ipairs(child:GetDescendants()) do
                            if v.Name == "SparkDots" then
                                part = v.Parent
                                break
                            end
                        end
                        if part then
                            local partPos = nil
                            pcall(function() partPos = part.Position end)
                            if partPos then
                                local d = vdist(partPos, rootPos)
                                if d < 10 then
                                    local addr = "validated_" .. getAddress(part)
                                    if not seenIndicators[addr] then
                                        seenIndicators[addr] = true
                                        validatedParry = os.clock()
                                        lastParryTime  = 0
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

