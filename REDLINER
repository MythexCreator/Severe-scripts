local maxHealthCache = {}
local charRefCache   = {}

local function getMaxHealth(player, currentHealth)
    if not currentHealth or currentHealth <= 0 then
        return maxHealthCache[player] or 100
    end
    local cached = maxHealthCache[player]
    if not cached then
        maxHealthCache[player] = currentHealth
        return currentHealth
    end
    if currentHealth > cached then
        maxHealthCache[player] = currentHealth
        return currentHealth
    end
    return cached
end

