local function handleDrag()
    if not MenuVisible then return end
    local headerSize = Vector2.new(UI.Size.X, UI.HeaderHeight)
    if Input.LeftPressedNow and not Dragging then
        if pointInRect(Input.Mouse, UI.Position, headerSize) then
            Dragging      = true
            DragOffset    = Input.Mouse - UI.Position
            ClickConsumed = true
        end
    end
    if Dragging then
        if Input.LeftDown then
            UI.Position = Input.Mouse - DragOffset
        else
            Dragging = false
        end
    end
end

local function handleTabClicks(tabBarPos)
    if not Input.LeftPressedNow or ClickConsumed then return end
    local tabWidth = UI.Size.X / #Tabs
    for i, name in ipairs(Tabs) do
        local tPos  = Vector2.new(tabBarPos.X + (i-1) * tabWidth, tabBarPos.Y)
        local tSize = Vector2.new(tabWidth, UI.TabBarHeight)
        if pointInRect(Input.Mouse, tPos, tSize) then
            CurrentTab    = name
            ClickConsumed = true
            return
        end
    end
end

local function renderMenu()
    if not MenuVisible then return end
    local pos  = UI.Position
    local size = UI.Size
    drawRect(pos + Vector2.new(4, 4), size, Color3.fromRGB(0,0,0), 0.35)
    drawRect(pos, size, UI.Colors.Background, 0.96)
    drawOutline(pos, size, UI.Colors.Border, 1, 1)
    drawRect(pos, Vector2.new(size.X, UI.HeaderHeight), UI.Colors.Header, 1)
    drawText(pos + Vector2.new(12, 7), 16, UI.Colors.Accent, "REDLINER", false, 1)
    drawText(pos + Vector2.new(95, 9), 13, UI.Colors.TextDim, "// severe build", false, 1)

    local tabBarPos = pos + Vector2.new(0, UI.HeaderHeight)
    drawRect(tabBarPos, Vector2.new(size.X, UI.TabBarHeight), UI.Colors.TabBar, 1)
    handleTabClicks(tabBarPos)

    local tabWidth = size.X / #Tabs
    for i, name in ipairs(Tabs) do
        local tPos  = Vector2.new(tabBarPos.X + (i-1) * tabWidth, tabBarPos.Y)
        local tSize = Vector2.new(tabWidth, UI.TabBarHeight)
        local active = (CurrentTab == name)
        if active then
            drawRect(Vector2.new(tPos.X, tPos.Y + tSize.Y - 2), Vector2.new(tSize.X, 2), UI.Colors.TabActive, 1)
        end
        drawText(Vector2.new(tPos.X + tSize.X/2, tPos.Y + 9), 14,
            active and UI.Colors.Text or UI.Colors.TextDim, name, true, 1)
    end

    Cursor = Vector2.new(pos.X + UI.Padding, pos.Y + UI.HeaderHeight + UI.TabBarHeight + UI.Padding)
    if     CurrentTab == "Combat"   then renderTab_Combat()
    elseif CurrentTab == "ESP"      then renderTab_ESP()
    elseif CurrentTab == "Glares"   then renderTab_Glares()
    elseif CurrentTab == "Movement" then renderTab_Movement()
    elseif CurrentTab == "Settings" then renderTab_Settings()
    end

    drawText(Vector2.new(pos.X + UI.Padding, pos.Y + size.Y - 18), 12, UI.Colors.TextDim,
        "FPS " .. math_floor(get_overlay_fps()) .. "  |  斬", false, 1)
end

