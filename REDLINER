-- ESP RENDER
------------------------------------------------------------
local function getTeam(player)
    local ok, t = pcall(function() return player.Team end)
    if ok and t then return t end
    return nil
end

local function w2s(pos)
    local ok, v, onScreen = pcall(function()
        return CurrentCamera:WorldToScreenPoint(pos)
    end)
    if not ok or not v then return Vector2.new(0,0), false end
    return Vector2.new(v.X, v.Y), onScreen
end

local function healthColor(pct)
    if pct > 0.5 then
        local t = (pct - 0.5) * 2
        return Color3.new(1 - t, 1, 0)
    else
        local t = pct * 2
        return Color3.new(1, t, 0)
    end
end

local function renderESP()
    local anyESP = Config.ESP_Boxes or Config.ESP_Names or Config.ESP_HealthBar
                or Config.ESP_HealthText or Config.ESP_Tracers or Config.ESP_Distance
    if not anyESP then return end

    local myPos = getMyPosition()
    if not myPos then return end

    local myTeam = Config.ESP_TeamCheck and getTeam(LocalPlayer) or nil

    CurrentCamera = Workspace.CurrentCamera
    if not CurrentCamera then return end

    local rvOk, rv = pcall(function() return CurrentCamera.RightVector end)
    if not rvOk or not rv then return end

    local vpOk, vp = pcall(function() return CurrentCamera.ViewportSize end)
    if not vpOk or not vp then return end
    local vpX = vp.X
    local vpY = vp.Y

    local all = getPlayersList()
    for _, plr in pairs(all) do
        if plr == LocalPlayer then continue end

        if myTeam then
            local pTeam = getTeam(plr)
            if pTeam and pTeam == myTeam then continue end
        end

        local okC, char = pcall(function() return plr.Character end)
        if not okC or not char then continue end

        local okR, root = pcall(function() return char:FindFirstChild("HumanoidRootPart") end)
        if not okR or not root then continue end

        local okH, head = pcall(function() return char:FindFirstChild("Head") end)
        if not okH or not head then continue end

        local rootPos = nil
        pcall(function() rootPos = root.Position end)
        if not rootPos then continue end

        local headPos = nil
        pcall(function() headPos = head.Position end)
        if not headPos then continue end

        local health = getHealth(plr)
        if not health or health <= 0 then continue end

        local maxHealth = getMaxHealth(plr, health)
        local healthPct = math_clamp(health / maxHealth, 0, 1)

        local d = vdist(myPos, rootPos)
        if d > Config.ESP_MaxDist then continue end

        local topScreen, topVis = w2s(Vector3.new(headPos.X, headPos.Y + 1.5, headPos.Z))
        local botScreen, botVis = w2s(Vector3.new(rootPos.X, rootPos.Y - 3.3, rootPos.Z))
        if not topVis or not botVis then continue end

        local boxH = botScreen.Y - topScreen.Y
        if boxH < 8 then continue end

        local hw = 2.5
        local lEdge = w2s(Vector3.new(rootPos.X - rv.X*hw, rootPos.Y, rootPos.Z - rv.Z*hw))
        local rEdge = w2s(Vector3.new(rootPos.X + rv.X*hw, rootPos.Y, rootPos.Z + rv.Z*hw))
        local boxW  = math_abs(rEdge.X - lEdge.X)
        if boxW < 6 then boxW = boxH * 0.5 end

        local centerX = (lEdge.X + rEdge.X) / 2
        local boxX    = centerX - boxW/2
        local boxY    = topScreen.Y

        local mainColor = UI.Colors.Accent

        if Config.ESP_Boxes then
            DrawingImmediate.Rectangle(
                Vector2.new(boxX-1, boxY-1),
                Vector2.new(boxW+2, boxH+2),
                Color3.new(0,0,0), 0.6, 1
            )
            DrawingImmediate.Rectangle(
                Vector2.new(boxX, boxY),
                Vector2.new(boxW, boxH),
                mainColor, 0.9, 1.5
            )
        end

        if Config.ESP_HealthBar then
            local barW = 3
            local barH = boxH
            local barX = boxX - barW - 4
            local barY = boxY

            DrawingImmediate.FilledRectangle(
                Vector2.new(barX - 1, barY - 1),
                Vector2.new(barW + 2, barH + 2),
                Color3.new(0, 0, 0), 0.7
            )
            DrawingImmediate.FilledRectangle(
                Vector2.new(barX, barY),
                Vector2.new(barW, barH),
                Color3.fromRGB(30, 30, 30), 0.9
            )
            local fillH = barH * healthPct
            DrawingImmediate.FilledRectangle(
                Vector2.new(barX, barY + barH - fillH),
                Vector2.new(barW, fillH),
                healthColor(healthPct), 1
            )
        end

        local ty = boxY - 16
        if Config.ESP_Names then
            local okN, name = pcall(function() return plr.DisplayName end)
            if not okN or not name then
                pcall(function() name = plr.Name end)
            end
            if name then
                drawOutlinedText(
                    Vector2.new(centerX, ty), 13,
                    Color3.new(1,1,1), name, true, 1
                )
                ty = ty - 14
            end
        end

        if Config.ESP_HealthText then
            local hpText = math_floor(health) .. "/" .. math_floor(maxHealth) .. " HP"
            drawOutlinedText(
                Vector2.new(centerX, ty), 12,
                healthColor(healthPct), hpText, true, 1
            )
        end

        if Config.ESP_Distance then
            drawOutlinedText(
                Vector2.new(centerX, botScreen.Y + 4), 11,
                Color3.fromRGB(180, 180, 180),
                math_floor(d) .. "st", true, 0.9
            )
        end

        if Config.ESP_Tracers then
            DrawingImmediate.Line(
                Vector2.new(vpX/2, vpY),
                Vector2.new(centerX, botScreen.Y),
                mainColor, 0.55, 1, 1.5
            )
        end
    end
end

