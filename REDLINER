-- HELPER: snap to step
------------------------------------------------------------
local function snapToStep(value, step, min, max)
    local steps = math_floor((value - min) / step + 0.5)
    local snapped = min + steps * step
    if snapped < min then snapped = min end
    if snapped > max then snapped = max end
    return snapped
end

