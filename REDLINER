local function vdist(a, b)
    local dx = a.X - b.X
    local dy = a.Y - b.Y
    local dz = a.Z - b.Z
    return math_sqrt(dx*dx + dy*dy + dz*dz)
end

local function distanceSq(a, b)
    if not a or not b then return math_huge end
    local dx = b.X - a.X
    local dy = b.Y - a.Y
    local dz = b.Z - a.Z
    return dx*dx + dy*dy + dz*dz
end

local function getMyPosition()
    if not LocalPlayer then return nil end
    local ok, char = pcall(function() return LocalPlayer.Character end)
    if not ok or not char then return nil end
    local ok2, root = pcall(function() return char:FindFirstChild("HumanoidRootPart") end)
    if not ok2 or not root then return nil end
    local ok3, pos = pcall(function() return root.Position end)
    return ok3 and pos or nil
end

local function getPlayersList()
    local ok1, list1 = pcall(function() return Players:GetPlayers() end)
    if ok1 and list1 and type(list1) == "table" then
        local count = 0
        for _ in pairs(list1) do count = count + 1 end
        if count > 0 then
            Debug.playerListMethod = "GetPlayers (" .. count .. ")"
            return list1, count
        end
    end
    local ok2, list2 = pcall(function() return Players:GetChildren() end)
    if ok2 and list2 and type(list2) == "table" then
        local count = 0
        for _ in pairs(list2) do count = count + 1 end
        if count > 0 then
            Debug.playerListMethod = "GetChildren (" .. count .. ")"
            return list2, count
        end
    end
    Debug.playerListMethod = "FAILED"
    return {}, 0
end

local function getHealth(player)
    local ok, ro = pcall(function() return player:FindFirstChild("ReadOnly") end)
    if ok and ro then
        local ok2, hv = pcall(function() return ro:FindFirstChild("health") end)
        if ok2 and hv then
            local ok3, val = pcall(function() return hv.Value end)
            if ok3 and val ~= nil then
                Debug.healthCheckResult = "RO.health=" .. tostring(val)
                return val
            end
        end
    end
    local ok4, char = pcall(function() return player.Character end)
    if ok4 and char then
        local ok5, hum = pcall(function() return char:FindFirstChildOfClass("Humanoid") end)
        if ok5 and hum then
            local ok6, h = pcall(function() return hum.Health end)
            if ok6 and h ~= nil then
                Debug.healthCheckResult = "Hum=" .. tostring(h)
                return h
            end
        end
        local ok7, root = pcall(function() return char:FindFirstChild("HumanoidRootPart") end)
        if ok7 and root then
            Debug.healthCheckResult = "ALIVE"
            return 100
        end
    end
    Debug.healthCheckResult = "NONE"
    return nil
end

