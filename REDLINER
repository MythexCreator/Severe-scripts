local function updateInput()
    Input.Mouse           = UserInput:GetMouseLocation()
    Input.LeftDown        = isleftpressed()
    Input.LeftPressedNow  = Input.LeftDown and not _prevLeftDown
    Input.LeftReleasedNow = (not Input.LeftDown) and _prevLeftDown
    _prevLeftDown         = Input.LeftDown
end

local function pointInRect(p, pos, size)
    return p.X >= pos.X and p.X <= pos.X + size.X
       and p.Y >= pos.Y and p.Y <= pos.Y + size.Y
end

