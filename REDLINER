-- AURA
------------------------------------------------------------
local cachedTargets  = {}
local lastTargetScan = 0
local lastAttack     = 0
local lastAuraUpdate = 0

local function scanTargets()
    Debug.playersIterated = 0
    Debug.playersBlocked = 0
    Debug.playersNoHealth = 0
    Debug.playersOutOfRange = 0

    local targets = {}
    local myPos = getMyPosition()
    if not myPos then
        Debug.myPos = "nil"
        return targets
    end
    Debug.myPos = string.format("%.0f,%.0f,%.0f", myPos.X, myPos.Y, myPos.Z)

    local all, count = getPlayersList()
    Debug.playersInGame = count
    if count == 0 then return targets end

    local rangeSq = Config.AuraRange * Config.AuraRange

    for _, p in pairs(all) do
        Debug.playersIterated = Debug.playersIterated + 1
        if p ~= LocalPlayer then
            local okN, name = pcall(function() return p.Name end)
            if not okN or not name then
                Debug.playersBlocked = Debug.playersBlocked + 1
            elseif isBlockedName(name) then
                Debug.playersBlocked = Debug.playersBlocked + 1
            else
                local health = getHealth(p)
                if not health or health <= 0 then
                    Debug.playersNoHealth = Debug.playersNoHealth + 1
                else
                    local okC, char = pcall(function() return p.Character end)
                    if okC and char then
                        local okR, root = pcall(function() return char:FindFirstChild("HumanoidRootPart") end)
                        if okR and root then
                            local okP, rootPos = pcall(function() return root.Position end)
                            if okP and rootPos then
                                local distSq = distanceSq(myPos, rootPos)
                                if distSq <= rangeSq then
                                    table_insert(targets, {
                                        player = p,
                                        root = root,
                                        health = health,
                                        distance = math_sqrt(distSq),
                                    })
                                else
                                    Debug.playersOutOfRange = Debug.playersOutOfRange + 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return targets
end

local function getAllTargets()
    local now = tick()
    if now - lastTargetScan >= 0.1 then
        cachedTargets = scanTargets()
        lastTargetScan = now
    end
    return cachedTargets
end

local function performAttack()
    Debug.attackAttempts = Debug.attackAttempts + 1
    local now = tick()
    if now - lastAttack < (Config.AttackCooldown - 0.02) then
        Debug.lastAttackResult = "cooldown"
        return false
    end
    if Config.RequireFocus then
        local okF, focused = pcall(isrbxactive)
        Debug.rbxActive = okF and focused or false
        if okF and not focused then
            Debug.lastAttackResult = "not focused"
            return false
        end
    end
    lastAttack = now

    if Config.UsePressRelease then
        local ok1 = pcall(mouse1press)
        if ok1 then
            task_wait(0.016)
            pcall(mouse1release)
            Debug.lastAttackResult = "press OK"
            Debug.attackSuccess = Debug.attackSuccess + 1
            return true
        end
        Debug.lastAttackResult = "press FAILED"
        return false
    end

    local ok = pcall(mouse1click)
    Debug.lastAttackResult = "click=" .. tostring(ok)
    if ok then Debug.attackSuccess = Debug.attackSuccess + 1 end
    return ok
end

local function updateAura()
    if not Config.AutoClick then return end
    local now = tick()
    if now - lastAuraUpdate < Config.AuraInterval then return end
    lastAuraUpdate = now
    Debug.auraTickCount = Debug.auraTickCount + 1
    Debug.lastAuraTick = now

    local targets = getAllTargets()
    Debug.targetsFound = #targets

    if #targets > 0 then
        local target = targets[1]
        if Config.VerifyTarget and target.root then
            local ok, curPos = pcall(function() return target.root.Position end)
            local myPos = getMyPosition()
            if ok and curPos and myPos then
                if distanceSq(myPos, curPos) <= Config.AuraRange * Config.AuraRange then
                    performAttack()
                end
            else
                performAttack()
            end
        else
            performAttack()
        end
    end
end

