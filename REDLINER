------------------------------------------------------------
local function saveConfig()
    Debug.lastSaveAttempt = "trying..."
    local ok, encoded = pcall(function() return crypt.json.encode(Config) end)
    if not ok then
        Debug.lastSaveAttempt = "encode FAIL: " .. tostring(encoded):sub(1, 30)
        return false
    end
    local ok2, err = pcall(function() writefile(CONFIG_FILE, encoded) end)
    if ok2 then
        Debug.saveCount = Debug.saveCount + 1
        Debug.lastSaveAttempt = "OK #" .. Debug.saveCount .. " (" .. #encoded .. "b)"
        return true
    else
        Debug.lastSaveAttempt = "writefile FAIL: " .. tostring(err):sub(1, 30)
        return false
    end
end

local function loadConfig()
    local ok, exists = pcall(function() return isfile(CONFIG_FILE) end)
    if not ok or not exists then return false end
    local ok2, content = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok2 or not content then return false end
    local ok3, decoded = pcall(function() return crypt.json.decode(content) end)
    if not ok3 or type(decoded) ~= "table" then return false end
    for k, v in pairs(decoded) do
        if Config[k] ~= nil then Config[k] = v end
    end
    return true
end

loadConfig()

